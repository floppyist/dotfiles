/* Generated by `dotfiles apply` from dotfiles.conf (template: templates/rofi.rasi).
 * Do not edit: changes are overwritten. Imported by ~/.config/rofi/config.rasi. */

configuration {
    drun-display-format: "{name}[<span foreground='{{muted}}'>  ·  {generic}</span>]";
}

* {
    bg:          {{bg}};
    surface:     {{surface}};
    overlay:     {{overlay}};
    fg:          {{fg}};
    subtle:      {{subtle}};
    muted:       {{muted}};
    accent:      {{accent}};
    accent-text: {{accent_text}};
    frame:       {{border_width}}px;
    /* rofi cannot combine "bold" with a color reference, so the whole value is one */
    match:       bold {{accent_text}};

    font: "{{font}} {{font_size_menu}}";
}
