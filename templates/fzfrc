# Generated by `dotfiles apply` from dotfiles.conf (template: templates/fzfrc).
# Do not edit: changes are overwritten. fzf reads it on every start (FZF_DEFAULT_OPTS_FILE, set in .bashrc).
#
# Same look as rofi and the shell prompt: input line on top with a chevron and the counter on
# the right, the selected row on the surface color with an accent bar, matches in the accent.
# The shell key bindings (Ctrl+r, Ctrl+t, Alt+c) add their own prompt in .bashrc.
# Needs fzf 0.66 (--gutter). No apostrophes in these comments: fzf splits the file like a shell.

--layout=reverse
--info=inline-right
--prompt='❯ '
--ghost=search
--gutter=' '
--highlight-line
--preview-window=border-sharp

--color=fg:{{subtle}},fg+:{{fg}},bg:-1,bg+:{{surface}},gutter:-1
--color=hl:{{accent_text}}:bold,hl+:{{accent_text}}:bold
--color=query:{{fg}},ghost:{{muted}},prompt:{{subtle}},pointer:{{accent}},marker:{{accent_text}}
--color=info:{{subtle}},spinner:{{accent_text}},header:{{muted}},label:{{subtle}}
--color=border:{{overlay}},separator:{{overlay}},scrollbar:{{overlay}}
