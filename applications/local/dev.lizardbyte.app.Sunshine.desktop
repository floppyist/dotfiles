[Desktop Entry]
Type=Application
Name=Sunshine
GenericName=Game Streaming Host
Comment=Self-hosted stream host for Moonlight
Exec=sh -c "nohup sunshine > /dev/null 2>&1 &"
TryExec=sunshine
Icon=dev.lizardbyte.app.Sunshine
Terminal=false
StartupWMClass=dev.lizardbyte.app.Sunshine
Categories=Network;RemoteAccess;
Keywords=stream;moonlight;remote play;
