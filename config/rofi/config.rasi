/* rofi  ·  launcher and system menus (fzf-style)
 *
 *  ┌──────────────────────────────────────────────┐
 *  │ apps ❯ search                          12/48 │  inputbar, accent underline
 *  │ message (only with -mesg)                    │
 *  │▌Firefox  · Web Browser                       │  selected: accent bar + surface
 *  │ Signal   · Messenger                         │
 *  └──────────────────────────────────────────────┘
 *
 *  Colors (@bg @surface @overlay @fg @subtle @muted @accent @accent-text), the font,
 *  the frame width, drun-display-format and the sizes (@df-*, scaled by `scale`) come
 *  from dotfiles.conf (templates/rofi.rasi). The defaults below are for scale 1.
 */

configuration {
    modi:                "drun";
    show-icons:          false;
    display-drun:        "apps";
    sidebar-mode:        false;
}

* {
    background-color: transparent;
    text-color:       @fg;

    df-width:         640px;
    df-input-padding: 14px 16px;
    df-input-spacing: 10px;
    df-input-line:    0px 0px 2px 0px;
    df-mesg-padding:  10px 16px;
    df-mesg-line:     0px 0px 1px 0px;
    df-list-padding:  6px 0px;
    df-row-padding:   8px 16px 8px 13px;
    df-row-bar:       0px 0px 0px 3px;
}

window {
    location:         center;
    anchor:           center;
    width:            @df-width;
    background-color: @bg;
    border:           @frame;
    border-color:     @overlay;
    border-radius:    0px;
    padding:          0px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing:  0px;
}

/* ── input line ─────────────────────────────────────────────────────────── */

inputbar {
    background-color: @surface;
    padding:          @df-input-padding;
    spacing:          @df-input-spacing;
    border:           @df-input-line;
    border-color:     @accent;
    children:         [ prompt, textbox-chevron, entry, counter ];
}

prompt {
    text-color: @accent-text;
}

textbox-chevron {
    expand:     false;
    content:    "❯";
    text-color: @muted;
}

entry {
    placeholder:       "search";
    placeholder-color: @muted;
    text-color:        @fg;
    cursor:            text;
}

/* "12/48" without the inputbar spacing in between */
counter {
    orientation: horizontal;
    expand:      false;
    spacing:     0px;
    children:    [ num-filtered-rows, textbox-num-sep, num-rows ];
}

num-filtered-rows,
num-rows {
    expand:     false;
    text-color: @subtle;
}

textbox-num-sep {
    expand:     false;
    content:    "/";
    text-color: @muted;
}

/* ── message (rofi -mesg) ───────────────────────────────────────────────── */

message {
    padding:          @df-mesg-padding;
    border:           @df-mesg-line;
    border-color:     @overlay;
    background-color: @bg;
}

textbox {
    text-color: @subtle;
    markup:     true;
}

/* ── list ───────────────────────────────────────────────────────────────── */

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    dynamic:      true;
    scrollbar:    false;
    spacing:      0px;
    padding:      @df-list-padding;
}

element {
    padding:          @df-row-padding;
    border:           @df-row-bar;
    border-color:     transparent;
    background-color: transparent;
    text-color:       @subtle;
}

element selected {
    background-color: @surface;
    border-color:     @accent;
    text-color:       @fg;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        @match;
    vertical-align:   0.5;
}

/* Theme values from dotfiles.conf. Must stay the last statement: rofi 2.0 fails to
 * parse a file where anything follows an @import. */
@import "~/.config/dotfiles/rofi.rasi"
