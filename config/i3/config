# Colors
set $bg      #282828
set $red     #cc241d
set $blue    #458588
set $purple  #b16286
set $gray    #a89984

set $mod Mod1
set $term alacritty
set $menu rofi -show drun -theme ~/.config/rofi/config.rasi

font pango:JetBrainsMono Nerd Font 10

focus_follows_mouse off

# Autostart
exec --no-startup-id /usr/libexec/polkit-gnome-authentication-agent-1
exec --no-startup-id dunst
exec --no-startup-id setxkbmap de
exec --no-startup-id pipewire
exec --no-startup-id pipewire-pulse
exec --no-startup-id wireplumber
exec --no-startup-id xbanish
exec_always --no-startup-id xrdb -merge ~/.Xresources
exec_always --no-startup-id picom -b
exec_always --no-startup-id feh --bg-fill ~/images/wallpaper
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec_always --no-startup-id xsetroot -cursor_name left_ptr

# Screensaver
mode "nerdsaver" {
    bindsym Mod4+Shift+F12 mode "default"
}
for_window [class="^nerdsaver$"] floating enable, border none

exec --no-startup-id caffeine-ng
exec --no-startup-id xset s noblank
exec --no-startup-id xset s 60
exec --no-startup-id xset dpms 0 0 300
exec --no-startup-id xss-lock -- ~/.local/bin/nerdsaver-launch cycle 60

# bindsym $mod+Shift+s exec --no-startup-id ~/.local/bin/nerdsaver-launch --now cycle 60

default_border pixel 0
default_floating_border pixel 0

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

# Keybinds
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec i3-msg exit
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.local/bin/polybar-backlight.sh up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.local/bin/polybar-backlight.sh down
bindsym XF86Display exec --no-startup-id ~/.local/bin/bluetooth-toggle.sh
bindsym Print exec --no-startup-id ~/.local/bin/screenshot.sh
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+f fullscreen
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

# Lock
bindsym Mod4+l exec --no-startup-id ~/.local/bin/lock.sh

# Resize
bindsym $mod+r mode "resize"

mode "resize" {
    bindsym h resize shrink width 50px
        bindsym j resize grow height 50px
        bindsym k resize shrink height 50px
        bindsym l resize grow width 50px

# Return to default mode
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
