# i3 config
#
# Mod1 (Alt)   window management
# Mod4 (Super) system actions (lock, display, bluetooth, vpn, power)

# ── Theme from dotfiles.conf ───────────────────────────────────────────────────
# Window colors, font, floating border width, gaps, wallpaper and idle times
# (templates/i3.conf). Edit dotfiles.conf, then run `dotfiles apply`.
include ~/.config/dotfiles/i3.conf

set $mod Mod1
set $term ~/.local/bin/terminal.sh
set $menu rofi -show drun -theme ~/.config/rofi/config.rasi

focus_follows_mouse off

# Tiled windows have no border; floating windows get a thin frame (accent when focused)
default_border pixel 0

# ── Autostart ──────────────────────────────────────────────────────────────────
# Session setup (xrdb, keyboard, cursor) lives in ~/.xinitrc
exec --no-startup-id /usr/libexec/polkit-gnome-authentication-agent-1
exec --no-startup-id dunst
exec --no-startup-id pipewire
exec --no-startup-id pipewire-pulse
exec --no-startup-id wireplumber
exec --no-startup-id xbanish
# exec_always: i3 restart (Alt+Shift+r) brings back a crashed compositor; a second instance exits
exec_always --no-startup-id picom -b
exec_always --no-startup-id ~/.config/polybar/launch.sh

# ── Screensaver and lock ───────────────────────────────────────────────────────
# Idle times come from dotfiles.conf (`xset` runs in the included file; `dotfiles apply`
# also sets them live). Defaults:
# Idle 60 s:   screensaver (xss-lock notifier, any input ends it)
# Idle 300 s:  lock screen (60 s timeout + 240 s cycle), display off via DPMS
# Suspend / `loginctl lock-session`: lock immediately. --transfer-sleep-lock keeps
# the system awake until the screen is locked, so nothing is visible on resume.
exec --no-startup-id xss-lock --transfer-sleep-lock --notifier "$HOME/.local/bin/nerdsaver-launch cycle 60" -- "$HOME/.local/bin/lock.sh"

mode "nerdsaver" {
    bindsym Mod4+Shift+F12 mode "default"
}
for_window [class="^nerdsaver$"] floating enable, border none

# Terminal tools started from rofi: centered floating window
for_window [class="^tool-float$"] floating enable, resize set 1000 650, move position center

# ── Workspaces ─────────────────────────────────────────────────────────────────
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

# ── Keybinds: windows (Alt) ────────────────────────────────────────────────────
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id ~/.local/bin/power-menu.sh
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+f fullscreen
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# ── Keybinds: system (Super, media keys) ───────────────────────────────────────
bindsym Mod4+l exec --no-startup-id ~/.local/bin/lock.sh
bindsym Mod4+p exec --no-startup-id ~/.local/bin/display-select.sh
# The function key that sends XF86Display is used as the Bluetooth key on this machine
bindsym XF86Display exec --no-startup-id ~/.local/bin/bluetooth-toggle.sh
bindsym Mod4+b exec --no-startup-id ~/.local/bin/bluetooth-toggle.sh
bindsym Mod4+v exec --no-startup-id ~/.local/bin/vpn

# Volume and brightness show an on-screen bar (dunst)
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.local/bin/volume.sh up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.local/bin/volume.sh down
bindsym XF86AudioMute exec --no-startup-id ~/.local/bin/volume.sh mute
bindsym XF86AudioMicMute exec --no-startup-id ~/.local/bin/volume.sh mic
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.local/bin/polybar-backlight.sh up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.local/bin/polybar-backlight.sh down

# Screenshots: full screen / selected region (both also copied to the clipboard)
bindsym Print exec --no-startup-id ~/.local/bin/screenshot.sh
bindsym Shift+Print exec --no-startup-id ~/.local/bin/screenshot.sh --select

# ── Resize mode ────────────────────────────────────────────────────────────────
bindsym $mod+r mode "resize"

mode "resize" {
    bindsym h resize shrink width 50px
    bindsym j resize grow height 50px
    bindsym k resize shrink height 50px
    bindsym l resize grow width 50px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
