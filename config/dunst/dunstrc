[global]
    monitor = 0
    follow = keyboard
    origin = top-right
    offset = (12, 52)
    width = (300, 340)
    height = (0, 120)
    notification_limit = 5
    gap_size = 8
    corner_radius = 0
    frame_width = 2
    frame_color = "#458588"
    separator_height = 0
    padding = 12
    horizontal_padding = 14
    font = JetBrainsMono Nerd Font 10
    foreground = "#ebdbb2"
    background = "#191c1c"
    alignment = left
    icon_position = left
    max_icon_size = 40
    hide_duplicate_count = yes
    show_age_threshold = 60
    sort = yes
    format = "<b>%s</b>\n%b"

[urgency_low]
    background = "#191c1c"
    foreground = "#a89984"
    frame_color = "#a89984"
    timeout = 5

[urgency_normal]
    background = "#191c1c"
    foreground = "#ebdbb2"
    frame_color = "#458588"
    timeout = 8

[urgency_critical]
    background = "#191c1c"
    foreground = "#ebdbb2"
    frame_color = "#cc241d"
    highlight = "#cc241d"
    timeout = 0

[signal_desktop]
    appname = Signal
    summary = "*"
    frame_color = "#689d6a"
    timeout = 10
