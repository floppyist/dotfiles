#!/usr/bin/env python3
"""displays - arrange the monitors (rofi), remember the layout, follow hotplugs

usage: displays            menu: resolution, refresh rate, position, rotation, primary, on/off
       displays restore    put the saved layout for the connected monitors back (else: extend)
       displays save       remember the current layout for the connected monitors
       displays watch      follow monitor hotplugs (udev): restore, then `dotfiles apply --layout`

Layouts are remembered per set of connected monitors (output name + EDID), in
$XDG_STATE_HOME/dotfiles/displays.json. Every change in the menu that could leave a screen
dark (resolution, rate, rotation, on/off) is reverted after 15 s unless confirmed.
After a change `dotfiles apply --layout` re-places the bar and the wallpaper and, with
scale = auto, sets the scale for the primary monitor.
"""
import fcntl
import hashlib
import json
import os
import re
import select
import signal
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
ROFI_MENU = os.path.join(HERE, "rofi-menu")
DOTFILES = os.path.join(HERE, "dotfiles")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                     "dotfiles", "displays.json")
CONFIRM_SECONDS = 15
ROTATIONS = ["normal", "left", "right", "inverted"]
INTERNAL_RE = re.compile(r"(eDP|LVDS|DSI)")

# Nerd Font md-* glyphs (verified against JetBrainsMono Nerd Font)
I_LAPTOP, I_MONITOR, I_OFF = "\U000F0322", "\U000F0379", "\U000F0D90"
I_RES, I_RATE, I_POS = "\U000F0A24", "\U000F04C5", "\U000F004C"
I_ROTATE, I_PRIMARY, I_BACK = "\U000F0475", "\U000F04CE", "\U000F004D"
I_KEEP, I_REVERT, I_DETECT = "\U000F012C", "\U000F054C", "\U000F0450"
I_MIRROR = "\U000F0191"

# "eDP connected primary 1920x1080+0+0 (0x57) normal (normal left inverted right x axis y axis) 309mm x 174mm"
HEAD_RE = re.compile(r"^(\S+) (connected|disconnected)( primary)?(?: (\d+)x(\d+)\+(-?\d+)\+(-?\d+))?"
                     r"(?: \(0x[0-9a-f]+\))?(?: (normal|left|right|inverted))?")
MODE_RE = re.compile(r"^\s+(\d+)x(\d+)(i?)\s+(.*)$")
RATE_RE = re.compile(r"(\d+\.\d+)([ *])([ +]?)")
NAME_RE = re.compile(r"^[A-Za-z0-9_.-]{1,32}$")


# ── reading the state ──────────────────────────────────────────────────────────

def xrandr(*args, check=False):
    try:
        r = subprocess.run(["xrandr", *args], stdin=subprocess.DEVNULL, capture_output=True,
                           text=True, timeout=20)
    except (OSError, subprocess.SubprocessError) as e:
        if check:
            raise RuntimeError("xrandr: %s" % e)
        return None
    if check and r.returncode != 0:
        raise RuntimeError("xrandr: %s" % (r.stderr.strip().splitlines() or ["failed"])[-1])
    return r.stdout if r.returncode == 0 else None


def outputs(probe=False):
    """{name: output} from xrandr (--current unless probe: no re-probe, no flicker)."""
    text = xrandr("--verbose") if probe else xrandr("--current", "--verbose")
    if text is None:
        raise RuntimeError("xrandr failed (no X display?)")
    outs, cur, mode, edid = {}, None, None, None
    for line in text.splitlines():
        m = HEAD_RE.match(line)
        if m:
            name = m.group(1)
            if not NAME_RE.match(name):
                cur = None
                continue
            cur = {"name": name, "connected": m.group(2) == "connected", "primary": bool(m.group(3)),
                   "active": m.group(4) is not None, "rotate": m.group(8) or "normal",
                   "modes": [], "edid": "", "mode": None, "rate": None}
            if cur["active"]:
                cur["geom"] = [int(m.group(i)) for i in (4, 5, 6, 7)]
            outs[name] = cur
            mode, edid = None, None
            continue
        if cur is None:
            continue
        s = line.strip()
        if edid is not None:
            if re.fullmatch(r"[0-9a-f]{32}", s):
                edid.append(s)
                continue
            cur["edid"] = hashlib.sha1("".join(edid).encode()).hexdigest()[:12] if edid else ""
            edid = None
        if s == "EDID:":
            edid = []
            continue
        # verbose mode lines: "  1920x1080 (0x57) 148.500MHz +HSync -VSync *current +preferred"
        mm = re.match(r"^\s+(\d+)x(\d+)(i?) \(0x[0-9a-f]+\) .*?$", line)
        if mm:
            mode = {"w": int(mm.group(1)), "h": int(mm.group(2)), "i": mm.group(3),
                    "current": "*current" in line, "preferred": "+preferred" in line, "rate": None}
            cur["modes"].append(mode)
            continue
        mv = re.match(r"^\s+v:.*clock\s+([0-9.]+)Hz", line)
        if mv and mode is not None and mode["rate"] is None:
            mode["rate"] = "%.2f" % float(mv.group(1))
    for o in outs.values():
        cur_mode = next((m for m in o["modes"] if m["current"]), None)
        if cur_mode and o["active"]:
            o["mode"] = "%dx%d%s" % (cur_mode["w"], cur_mode["h"], cur_mode["i"])
            o["rate"] = cur_mode["rate"]
    return outs


def mode_names(o):
    """Resolutions, largest first, the preferred one marked."""
    seen, out = set(), []
    for m in sorted(o["modes"], key=lambda m: (m["w"] * m["h"], m["w"], m["i"] == ""), reverse=True):
        n = "%dx%d%s" % (m["w"], m["h"], m["i"])
        if n not in seen:
            seen.add(n)
            out.append((n, any(x["preferred"] for x in o["modes"] if "%dx%d%s" % (x["w"], x["h"], x["i"]) == n)))
    return out


def rates(o, mode):
    seen = []
    for m in o["modes"]:
        if "%dx%d%s" % (m["w"], m["h"], m["i"]) == mode and m["rate"] and m["rate"] not in seen:
            seen.append(m["rate"])
    return sorted(seen, key=float, reverse=True)


def preferred(o):
    names = mode_names(o)
    return next((n for n, p in names if p), names[0][0] if names else None)


# ── the layout model ───────────────────────────────────────────────────────────
# {name: {"mode": "WxH", "rate": "60.00", "x": 0, "y": 0, "rotate": "normal", "primary": bool}
#  or {"off": True}} for every connected output

def current_layout(outs):
    lay = {}
    for n, o in outs.items():
        if not o["connected"]:
            continue
        if not o["active"] or not o["mode"]:
            lay[n] = {"off": True}
            continue
        g = o["geom"]
        lay[n] = {"mode": o["mode"], "rate": o["rate"], "x": g[2], "y": g[3], "rotate": o["rotate"],
                  "primary": o["primary"]}
    return lay


def size(entry):
    w, h = (int(v) for v in re.match(r"(\d+)x(\d+)", entry["mode"]).groups())
    return (h, w) if entry["rotate"] in ("left", "right") else (w, h)


def normalize(lay):
    on = [e for e in lay.values() if not e.get("off")]
    if not on:
        return lay
    dx, dy = min(e["x"] for e in on), min(e["y"] for e in on)
    for e in on:
        e["x"] -= dx
        e["y"] -= dy
    if not any(e.get("primary") for e in on):
        name = next((n for n, e in lay.items() if not e.get("off") and INTERNAL_RE.match(n)), None)
        name = name or next(n for n, e in lay.items() if not e.get("off"))
        lay[name]["primary"] = True
    return lay


def resize(lay, name, new_entry):
    """Replace an output's entry; outputs right of / below it move with its new size."""
    old = lay[name]
    if not old.get("off"):
        ow, oh = size(old)
        nw, nh = size(new_entry)
        for n, e in lay.items():
            if n == name or e.get("off"):
                continue
            if e["x"] >= old["x"] + ow:
                e["x"] += nw - ow
            if e["y"] >= old["y"] + oh:
                e["y"] += nh - oh
    lay[name] = new_entry
    return normalize(lay)


def rightmost(lay, skip):
    on = [(n, e) for n, e in lay.items() if n != skip and not e.get("off")]
    if not on:
        return 0, 0
    n, e = max(on, key=lambda ne: ne[1]["x"] + size(ne[1])[0])
    return e["x"] + size(e)[0], e["y"]


def xrandr_args(lay, outs):
    args = []
    for n, o in outs.items():
        e = lay.get(n)
        if e is None or e.get("off"):
            if o["active"] or e is not None:
                args += ["--output", n, "--off"]
            continue
        args += ["--output", n, "--mode", e["mode"]]
        if e.get("rate"):
            args += ["--rate", e["rate"]]
        args += ["--pos", "%dx%d" % (e["x"], e["y"]), "--rotate", e["rotate"]]
        if e.get("primary"):
            args += ["--primary"]
    return args


def apply_layout(lay, outs):
    xrandr(*xrandr_args(lay, outs), check=True)


# ── saved layouts ──────────────────────────────────────────────────────────────

def setup_key(outs):
    return ",".join(sorted("%s=%s" % (n, o["edid"]) for n, o in outs.items() if o["connected"]))


def load_saved():
    try:
        data = json.load(open(STATE, encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save(outs=None):
    outs = outs or outputs()
    data = load_saved()
    data[setup_key(outs)] = current_layout(outs)
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=1, sort_keys=True)
    os.replace(tmp, STATE)


def valid_entry(e, o):
    if not isinstance(e, dict):
        return False
    if e.get("off") is True:
        return True
    names = [n for n, _ in mode_names(o)]
    return (e.get("mode") in names and isinstance(e.get("x"), int) and isinstance(e.get("y"), int)
            and e.get("rotate") in ROTATIONS and (e.get("rate") is None or e.get("rate") in rates(o, e["mode"])))


def extend(outs):
    """Layout for a setup without a saved one: every connected monitor on (running ones keep
    their mode and rotation), side by side, the laptop panel first; the primary stays."""
    lay, x = {}, 0
    old = current_layout(outs)
    for n in sorted(old, key=lambda n: (not INTERNAL_RE.match(n), n)):
        e = old[n]
        if e.get("off"):
            mode = preferred(outs[n])
            if not mode:
                lay[n] = {"off": True}
                continue
            e = {"mode": mode, "rate": None, "rotate": "normal", "primary": False}
        lay[n] = dict(e, x=x, y=0)
        x += size(lay[n])[0]
    return normalize(lay)


def restore(probe=False):
    """Saved layout for these monitors, else extend(). Unplugged monitors are turned off.
    Returns what was done, None when nothing had to change."""
    outs = outputs(probe)
    saved = load_saved().get(setup_key(outs))
    cur = current_layout(outs)
    if isinstance(saved, dict) and set(saved) == set(cur) and all(valid_entry(saved[n], outs[n]) for n in saved):
        lay, what = normalize({n: dict(e) for n, e in saved.items()}), "saved layout"
    elif not cur:
        return None
    else:
        lay, what = extend(outs), "extended"
    stale = any(o["active"] and not o["connected"] for o in outs.values())
    if lay == cur and not stale:
        return None
    apply_layout(lay, outs)
    return what


# ── desktop ────────────────────────────────────────────────────────────────────

def notify(summary, body="", urgency="normal"):
    try:
        subprocess.run(["notify-send", "-a", "display", "-u", urgency, summary, body],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass


def refresh():
    """Bar, wallpaper and (scale = auto) the scale for the new layout."""
    try:
        subprocess.run([DOTFILES, "apply", "--layout"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=180)
    except (OSError, subprocess.SubprocessError):
        pass


# ── menu ───────────────────────────────────────────────────────────────────────

def menu(rows, prompt="display", mesg="", timeout=None):
    """Index of the chosen row, or None."""
    cmd = ([ "timeout", str(timeout)] if timeout else []) + [ROFI_MENU, prompt, mesg]
    try:
        r = subprocess.run(cmd, input="\n".join(rows) + "\n", capture_output=True, text=True)
    except OSError:
        return None
    s = r.stdout.strip()
    return int(s) if r.returncode == 0 and s.isdigit() and int(s) < len(rows) else None


def esc(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def describe(n, e, lay):
    if e.get("off"):
        return "off"
    parts = [e["mode"].replace("x", "\u00d7")]
    if e.get("rate"):
        parts.append("%s Hz" % e["rate"].rstrip("0").rstrip("."))
    if e["rotate"] != "normal":
        parts.append("rotated %s" % e["rotate"])
    rel = relation(n, e, lay)
    if rel:
        parts.append(rel)
    if e.get("primary"):
        parts.append("primary")
    return "  \u00b7  ".join(parts)


def relation(n, e, lay):
    w, h = size(e)
    for m, f in lay.items():
        if m == n or f.get("off"):
            continue
        fw, fh = size(f)
        if (e["x"], e["y"]) == (f["x"], f["y"]) and (w, h) == (fw, fh):
            return "same as %s" % m
        if e["x"] == f["x"] + fw:
            return "right of %s" % m
        if e["x"] + w == f["x"]:
            return "left of %s" % m
        if e["y"] == f["y"] + fh:
            return "below %s" % m
        if e["y"] + h == f["y"]:
            return "above %s" % m
    return ""


def icon(n, e):
    if e.get("off"):
        return I_OFF
    return I_LAPTOP if INTERNAL_RE.match(n) else I_MONITOR


def change(outs, lay, new, confirm):
    """Apply `new`; risky changes need a confirmation within 15 s. Returns the layout in use."""
    try:
        apply_layout(new, outs)
    except RuntimeError as e:
        notify("Display", str(e), "critical")
        try:
            apply_layout(lay, outs)
        except RuntimeError:
            pass
        return lay
    if confirm:
        i = menu([I_REVERT + "  Revert", I_KEEP + "  Keep this layout"], "display",
                 "Reverting in %d s unless confirmed" % CONFIRM_SECONDS, timeout=CONFIRM_SECONDS)
        if i != 1:
            try:
                apply_layout(lay, outs)
            except RuntimeError as e:
                notify("Display", str(e), "critical")
            notify("Layout reverted", "")
            return lay
    save()
    refresh()
    return new


def output_menu(name, outs, lay):
    while True:
        e = lay[name]
        o = outs[name]
        on = not e.get("off")
        others = [n for n, f in lay.items() if n != name and not f.get("off")]
        rows, acts = [], []
        if on:
            rows += ["%s  Resolution    %s" % (I_RES, e["mode"].replace("x", "\u00d7")),
                     "%s  Refresh rate  %s" % (I_RATE, ("%s Hz" % e["rate"].rstrip("0").rstrip(".")) if e.get("rate") else "auto"),
                     "%s  Rotation      %s" % (I_ROTATE, e["rotate"])]
            acts += ["mode", "rate", "rotate"]
            if others:
                rows.append("%s  Position      %s" % (I_POS, relation(name, e, lay) or "%d, %d" % (e["x"], e["y"])))
                acts.append("pos")
            if not e.get("primary"):
                rows.append("%s  Make primary  (bar, scale)" % I_PRIMARY)
                acts.append("primary")
            if others:
                rows.append("%s  Turn off" % I_OFF)
                acts.append("off")
        else:
            rows.append("%s  Turn on" % I_MONITOR)
            acts.append("on")
        rows.append("%s  Back" % I_BACK)
        acts.append("back")
        i = menu(rows, name, esc(describe(name, e, lay)))
        if i is None or acts[i] == "back":
            return lay
        act = acts[i]
        new = {n: dict(f) for n, f in lay.items()}
        if act == "mode":
            names = mode_names(o)
            j = menu(["%s%s" % (n.replace("x", "\u00d7"), "  (recommended)" if p else "") for n, p in names],
                     "resolution", esc(name))
            if j is None:
                continue
            new = resize(new, name, dict(e, mode=names[j][0], rate=None))
            lay = change(outs, lay, new, True)
        elif act == "rate":
            rs = rates(o, e["mode"])
            if not rs:
                continue
            j = menu(["%s Hz" % r for r in rs], "refresh rate", esc("%s  \u00b7  %s" % (name, e["mode"])))
            if j is None:
                continue
            new[name] = dict(e, rate=rs[j])
            lay = change(outs, lay, new, True)
        elif act == "rotate":
            j = menu(ROTATIONS, "rotation", esc(name))
            if j is None:
                continue
            new = resize(new, name, dict(e, rotate=ROTATIONS[j]))
            lay = change(outs, lay, new, True)
        elif act == "pos":
            opts = []
            for m in others:
                opts += [("right", m), ("left", m), ("above", m), ("below", m), ("same", m)]
            labels = {"right": "right of", "left": "left of", "above": "above", "below": "below",
                      "same": "same as (mirror)"}
            j = menu(["%s  %s %s" % (I_MIRROR if k == "same" else I_POS, labels[k], m) for k, m in opts],
                     "position", esc(name))
            if j is None:
                continue
            k, m = opts[j]
            a = new[m]
            aw, ah = size(a)
            w, h = size(e)
            x, y = {"right": (a["x"] + aw, a["y"]), "left": (a["x"] - w, a["y"]),
                    "above": (a["x"], a["y"] - h), "below": (a["x"], a["y"] + ah),
                    "same": (a["x"], a["y"])}[k]
            new[name] = dict(e, x=x, y=y)
            if k == "same" and a["mode"] in [n for n, _ in mode_names(o)]:
                new[name]["mode"], new[name]["rate"] = a["mode"], None
            lay = change(outs, lay, normalize(new), k == "same")
        elif act == "primary":
            for f in new.values():
                f.pop("primary", None) if f.get("off") else f.update(primary=False)
            new[name]["primary"] = True
            lay = change(outs, lay, new, False)
        elif act == "off":
            new = resize(new, name, {"off": True})
            if e.get("primary"):
                for f in new.values():
                    if not f.get("off"):
                        f["primary"] = False
                new = normalize(new)
            lay = change(outs, lay, normalize(new), True)
        elif act == "on":
            mode = preferred(o)
            if not mode:
                continue
            x, y = rightmost(new, name)
            new[name] = {"mode": mode, "rate": None, "x": x, "y": y, "rotate": "normal", "primary": False}
            lay = change(outs, lay, normalize(new), True)
        outs = outputs()


def main_menu():
    while True:
        outs = outputs()
        lay = current_layout(outs)
        names = sorted(lay, key=lambda n: (not INTERNAL_RE.match(n), n))
        rows = ["%s  %s   %s" % (icon(n, lay[n]), n, describe(n, lay[n], lay)) for n in names]
        rows.append("%s  Detect monitors" % I_DETECT)
        scale = ""
        try:
            scale = subprocess.run([DOTFILES, "get", "scale"], capture_output=True, text=True,
                                   timeout=10).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            pass
        mesg = "scale %s  \u00b7  the primary monitor decides" % esc(scale) if scale else ""
        i = menu(rows, "displays", mesg)
        if i is None:
            return 0
        if i == len(names):
            what = restore(probe=True)
            refresh()
            notify("Monitors detected", what or "nothing changed")
            continue
        output_menu(names[i], outs, lay)


# ── hotplug ────────────────────────────────────────────────────────────────────

def runtime_dir():
    d = os.environ.get("XDG_RUNTIME_DIR", "")
    if d and os.path.isdir(d) and os.stat(d).st_uid == os.getuid():
        return d
    d = os.path.expanduser("~/.cache/displays")
    os.makedirs(d, mode=0o700, exist_ok=True)
    return d


def watch():
    """One watcher per display: udev drm events -> restore + dotfiles apply --layout."""
    tag = re.sub(r"[^A-Za-z0-9]", "_", os.environ.get("DISPLAY", ""))
    lock = open(os.path.join(runtime_dir(), "displays-watch%s.lock" % tag), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0
    def die_with_parent():
        # udevadm would otherwise outlive us until its next event (SIGPIPE)
        try:
            import ctypes
            ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGTERM)    # PR_SET_PDEATHSIG
        except (OSError, AttributeError):
            pass

    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGHUP, lambda *_: sys.exit(0))
    try:
        mon = subprocess.Popen(["udevadm", "monitor", "--udev", "--subsystem-match=drm"],
                               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                               preexec_fn=die_with_parent)
    except OSError as e:
        print("displays: udevadm: %s" % e, file=sys.stderr)
        return 1
    try:
        known = setup_key(outputs())
        buf = b""
        while True:
            r, _, _ = select.select([mon.stdout], [], [], 60)
            if not r:
                if xrandr("--current") is None:       # X is gone: the session ended
                    return 0
                continue
            chunk = os.read(mon.stdout.fileno(), 4096)
            if not chunk:
                return 1
            buf += chunk
            if b" change " not in buf and b" add " not in buf and b" remove " not in buf:
                buf = buf[-256:]
                continue
            buf = b""
            # one hotplug sends several events, and the X server re-probes on its own
            end = time.monotonic() + 1.5
            while time.monotonic() < end:
                r, _, _ = select.select([mon.stdout], [], [], max(0, end - time.monotonic()))
                if r and not os.read(mon.stdout.fileno(), 4096):
                    return 1
            try:
                outs = outputs(probe=True)
            except RuntimeError:
                return 0
            key = setup_key(outs)
            if key == known:
                continue    # e.g. a link-status event while the menu changed the mode
            known = key
            try:
                what = restore()
            except RuntimeError as e:
                notify("Display", str(e), "critical")
                continue
            refresh()
            on = [n for n, o in outputs().items() if o["active"]]
            notify("Monitors changed", "%s  \u00b7  %s" % (", ".join(on), what or "unchanged"))
    finally:
        mon.terminate()


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "menu"
    try:
        if cmd == "menu":
            return main_menu()
        if cmd == "restore":
            what = restore()
            print("displays: %s" % (what or "nothing to do"))
            return 0
        if cmd == "save":
            save()
            return 0
        if cmd == "watch":
            return watch()
    except RuntimeError as e:
        print("displays: %s" % e, file=sys.stderr)
        if cmd == "menu":
            notify("Display", str(e), "critical")
        return 1
    print(__doc__.strip())
    return 0 if cmd in ("help", "-h", "--help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
