USAGE = """usage: nerdsaver [list | random | cycle [seconds] [NAME ...] | NAME ...]

  list                  show all screensavers
  random                pick one at random (default)
  cycle [sec]           rotate through all of them in random order (default 60 s)
  cycle [sec] NAME ...  loop the given names in exactly this order
  NAME ...              run one, or loop the given names in this order (60 s each)

Any key ends the screensaver.
The pixel savers (blackhole planet aurora abyss flyover music) need numpy and look best in a
truecolor terminal. 'music' captures the speaker output with parec or pw-record, the track title
comes from playerctl.
Environment:
  NERDSAVER_ECO=1                       halves the frame rate (battery mode)
  NERDSAVER_GLYPHS=safe|katakana|ascii  matrix glyph set (default: safe)
  NERDSAVER_COLORS=24bit|256|16         color depth of the pixel savers (default: auto-detect)
  NERDSAVER_AUDIO=CMD                   audio capture command for 'music' (raw s16le, 44.1 kHz, stereo)
  NERDSAVER_TRANSPARENT=1               pixel savers show the (transparent) terminal background in black areas"""

ECO = os.environ.get("NERDSAVER_ECO") == "1"

GREEN, CYAN, YELLOW, RED, MAGENTA, BLUE, WHITE = 1, 2, 3, 4, 5, 6, 7
BOLD, DIM, REV = curses.A_BOLD, curses.A_DIM, curses.A_REVERSE
SPARK = "▁▂▃▄▅▆▇█"
BG = -1
PAIRS = {}

MAT = (231, 195, 157, 120, 83, 46, 40, 34, 28, 22)
HEAT = (27, 33, 39, 45, 48, 46, 82, 118, 154, 190, 226, 220, 214, 208, 202, 196)
BARP = (46, 82, 118, 154, 190, 226, 220, 214, 208, 202, 196)
RAIN = (196, 202, 208, 214, 220, 226, 190, 154, 118, 82, 46, 48, 50, 45, 39, 33, 27, 21, 57, 93, 129, 165, 201)
FRAC = (17, 19, 21, 27, 33, 39, 45, 51, 87, 123, 159, 231, 229, 227, 226, 220, 214, 208, 202, 196, 160, 125, 90, 54)
COOL = (17, 18, 19, 20, 21, 27, 33, 39, 45, 51, 87, 123, 159, 231)
WARM = (52, 88, 124, 160, 196, 202, 208, 214, 220, 226, 227, 229, 231)
FACTOR = (33, 39, 45, 141, 177, 213)
GRAYS = (236, 240, 244, 248, 252, 255)
ICE = (17, 18, 24, 31, 38, 45, 51, 159)
GOLD = (52, 94, 136, 178, 220, 226, 229)
PIPEC = (196, 208, 226, 46, 51, 39, 201, 129)


def setup_locale():
    for loc in ("", "C.UTF-8", "en_US.UTF-8"):
        try:
            locale.setlocale(locale.LC_ALL, loc)
            if locale.nl_langinfo(locale.CODESET).upper().replace("-", "") == "UTF8":
                return
        except locale.Error:
            pass


def init_colors():
    global BG
    curses.start_color()
    try:
        curses.use_default_colors()
        BG = -1
    except curses.error:
        BG = curses.COLOR_BLACK
    base = [curses.COLOR_GREEN, curses.COLOR_CYAN, curses.COLOR_YELLOW, curses.COLOR_RED,
            curses.COLOR_MAGENTA, curses.COLOR_BLUE, curses.COLOR_WHITE]
    for i, c in enumerate(base, 1):
        curses.init_pair(i, c, BG)


def col(n):
    return curses.color_pair(n)


def c256(n, fb=WHITE):
    if curses.COLORS < 256:
        return col(fb)
    p = PAIRS.get(n)
    if p is None:
        p = len(PAIRS) + 16
        curses.init_pair(p, n, BG)
        PAIRS[n] = p
    return curses.color_pair(p)


def mkpal(nums, fb=WHITE):
    if curses.COLORS < 256:
        half = len(nums) // 2
        return [col(fb) | (BOLD if i < half else DIM) for i in range(len(nums))]
    return [c256(n, fb) for n in nums]


def pick(pal, f):
    return pal[min(len(pal) - 1, max(0, int(f * len(pal))))]


def put(scr, y, x, s, attr=0):
    h, w = scr.getmaxyx()
    if y < 0 or y >= h or x >= w or not s:
        return
    if x < 0:
        s = s[-x:]
        x = 0
    s = s[: w - x]
    if not s:
        return
    try:
        scr.addstr(y, x, s, attr)
    except curses.error:
        pass


def runs(scr, y, x, row, chars, attrs):
    # draw a row of level codes, batching neighbouring cells with the same attribute into one addstr
    for a, grp in itertools.groupby(row, attrs.__getitem__):
        txt = "".join(map(chars.__getitem__, grp))
        try:
            scr.addstr(y, x, txt, a)
        except curses.error:
            pass
        x += len(txt)


def blit_np(scr, codes, prev, charr, akey, attrs):
    # numpy variant of runs() for a whole screen of 1-char codes; only redraws rows that changed
    H, W = codes.shape
    changed = range(H) if prev is None else np.flatnonzero((codes != prev).any(axis=1)).tolist()
    keys = akey[codes]
    for y in changed:
        txt = "".join(charr[codes[y]].tolist())
        kr = keys[y]
        krl = kr.tolist()
        a = 0
        for b in (np.flatnonzero(kr[1:] != kr[:-1]) + 1).tolist() + [W]:
            try:
                scr.addstr(y, a, txt[a:b], attrs[krl[a]])
            except curses.error:
                pass
            a = b
    return codes


# ---------------------------------------------------------------- pixel engine
# Pixel savers render an RGB float framebuffer (2*rows x cols x 3, values 0..1) with numpy. Pix turns it
# into half-block cells (two pixels per cell) and writes raw ANSI escapes, which allows 24-bit color and
# unlimited fg/bg combinations. Only changed cells are sent. Black is painted explicitly, so the picture
# stays opaque in a transparent terminal (NERDSAVER_TRANSPARENT=1 uses the terminal background instead).

BAYER4 = (0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5)
ANSI16 = ((0, 0, 0), (205, 0, 0), (0, 205, 0), (205, 205, 0), (0, 0, 238), (205, 0, 205), (0, 205, 205),
          (229, 229, 229), (127, 127, 127), (255, 0, 0), (0, 255, 0), (255, 255, 0), (92, 92, 255),
          (255, 0, 255), (0, 255, 255), (255, 255, 255))
LUTS = {}


def color_depth():
    v = os.environ.get("NERDSAVER_COLORS", "").lower()
    if v in ("24bit", "256", "16"):
        return v
    if os.environ.get("COLORTERM", "").lower() in ("truecolor", "24bit"):
        return "24bit"
    if re.search(r"kitty|alacritty|wezterm|foot|ghostty|direct", os.environ.get("TERM", "")):
        return "24bit"
    return "256" if curses.COLORS >= 256 else "16"


def palette_lut(depth):
    # 15-bit rgb (5 bits per channel) -> terminal color index, 0 = terminal background
    if depth in LUTS:
        return LUTS[depth]
    v = np.arange(32) * 255.0 / 31
    r, g, b = np.meshgrid(v, v, v, indexing="ij")
    rgb = np.stack([r.ravel(), g.ravel(), b.ravel()], 1)
    if depth == "16":
        pal = np.array(ANSI16, float)
        idx = np.argmin(((rgb[:, None, :] - pal[None]) ** 2).sum(2), 1)
    else:
        lv = np.array([0, 95, 135, 175, 215, 255], float)
        ci = np.argmin(np.abs(rgb[:, :, None] - lv), 2)
        gi = np.clip(np.round((rgb.mean(1) - 8) / 10), 0, 23)
        dc = ((rgb - lv[ci]) ** 2).sum(1)
        dg = ((rgb - (8 + 10 * gi)[:, None]) ** 2).sum(1)
        idx = np.where(dg < dc, 232 + gi, 16 + 36 * ci[:, 0] + 6 * ci[:, 1] + ci[:, 2])
        idx[idx == 16] = 0
    LUTS[depth] = idx = idx.astype(np.int64)
    return idx


class Pix:
    def __init__(s, scr, dither=None):
        scr.erase()
        scr.refresh()
        s.scr = scr
        s.rows, s.cols = scr.getmaxyx()
        s.H, s.W = 2 * s.rows, s.cols
        s.depth = color_depth()
        # code 0 (black) as background: opaque black, or the terminal's own (possibly transparent) background
        if os.environ.get("NERDSAVER_TRANSPARENT") == "1":
            s.bg0 = "\x1b[49m"
        else:
            s.bg0 = {"24bit": "\x1b[48;2;0;0;0m", "256": "\x1b[48;5;16m", "16": "\x1b[40m"}[s.depth]
        s.lut = None if s.depth == "24bit" else palette_lut(s.depth)
        s.lv = 63 if s.lut is None else 31
        if dither is None:
            dither = s.lut is not None
        if dither:
            yy, xx = np.mgrid[0:s.H, 0:s.W]
            s.dith = ((np.array(BAYER4).reshape(4, 4)[yy & 3, xx & 3] + 0.5) / 16.0)[..., None]
        else:
            s.dith = 0.5
        s.cut = 4.5 / 255
        s.prev = None
        s.txt = {}
        s.tcol = {}
        s.fgc, s.bgc = {}, {}
        s.write("\x1b[0m\x1b[2J")

    def write(s, data):
        b = data.encode("utf-8", "replace")
        while b:
            try:
                b = b[os.write(1, b):]
            except BlockingIOError:
                time.sleep(0.002)
            except OSError:
                return

    def close(s):
        s.write("\x1b[0m\x1b[2J")
        s.scr.clear()

    def codes(s, rgb, dith=None):
        lv = s.lv
        q = np.clip(rgb * lv + (s.dith if dith is None else dith), 0, lv).astype(np.int64)
        if s.lut is None:
            c = (q[..., 0] << 12) | (q[..., 1] << 6) | q[..., 2]
        else:
            c = s.lut[(q[..., 0] << 10) | (q[..., 1] << 5) | q[..., 2]]
        return np.where(rgb.max(-1) < s.cut, 0, c)

    def esc(s, c, bg):
        if s.lut is None:
            r, g, b = ((c >> 12) * 255 + 31) // 63, (((c >> 6) & 63) * 255 + 31) // 63, ((c & 63) * 255 + 31) // 63
            e = "\x1b[%d;2;%d;%d;%dm" % (48 if bg else 38, r, g, b)
        elif s.depth == "256":
            e = "\x1b[%d;5;%dm" % (48 if bg else 38, c)
        else:
            e = "\x1b[%dm" % ((40 if bg else 30) + c if c < 8 else (100 if bg else 90) + c - 8)
        (s.bgc if bg else s.fgc)[c] = e
        return e

    def text(s, y, x, txt, rgb):
        # queue text for the next show(); the cell background is a darkened copy of the pixels below
        if not 0 <= y < s.rows:
            return x
        key = tuple(rgb)
        fg = s.tcol.get(key)
        if fg is None:
            fg = s.tcol[key] = int(s.codes(np.array(rgb, float), 0.5))
            if len(s.tcol) > 4096:
                s.tcol.clear()
        for ch in unicodedata.normalize("NFC", txt):
            if unicodedata.combining(ch):
                p = s.txt.get((y, x - 1))
                if p and p[2] == 1:
                    s.txt[(y, x - 1)] = (p[0] + ch, p[1], 1)
                continue
            # control characters (C0, DEL, C1) never reach the terminal: track titles are text
            # other people chose, and this output is written raw (not through curses)
            if ch < " " or "\x7f" <= ch <= "\x9f":
                continue
            w = 2 if unicodedata.east_asian_width(ch) in "WF" else 1
            if 0 <= x and x + w <= s.cols:
                s.txt[(y, x)] = (ch, fg, w)
                if w == 2:
                    s.txt[(y, x + 1)] = ("\0" + ch, fg, 0)
            x += w
        return x

    def show(s, rgb):
        c = s.codes(rgb)
        top, bot = c[0::2], c[1::2]
        key = (top << 20) | bot
        tx, s.txt = s.txt, {}
        tcells = {}
        if tx:
            ks = list(tx)
            ys = np.array([k[0] for k in ks])
            xs = np.array([k[1] - (tx[k][2] == 0) for k in ks])
            bgs = s.codes((rgb[2 * ys, xs] + rgb[2 * ys + 1, xs]) * 0.3, 0.5).tolist()
            for k, bgc in zip(ks, bgs):
                ch, fg, w = tx[k]
                key[k] = (1 << 62) | ((hash(ch) & 0xFFFFF) << 40) | (fg << 20) | bgc
                tcells[k[0] * s.cols + k[1]] = (ch, fg, bgc, w)
        prev, s.prev = s.prev, key
        diff = np.ones(key.shape, bool) if prev is None or prev.shape != key.shape else key != prev
        idx = np.flatnonzero(diff.ravel())
        if not idx.size:
            return
        t, b = top.ravel()[idx], bot.ravel()[idx]
        both0 = (t == 0) & (b == 0)
        same = (t == b) & ~both0
        F = np.where(both0, -1, np.where(t != 0, t, b))
        G = np.where(same, -1, np.where((t == 0) | (b == 0), 0, b))
        chi = np.where(both0, 0, np.where(same, 1, np.where(t == 0, 3, 2)))
        wid = np.ones(idx.size, np.int64)
        chars = [" ", "\u2588", "\u2580", "\u2584"]
        if tcells:
            tc = np.array(sorted(tcells))
            pos = np.searchsorted(idx, tc)
            pos = pos[(pos < idx.size) & (idx[np.minimum(pos, idx.size - 1)] == tc)]
            drop = []
            for i in pos.tolist():
                ch, fg, bgc, w = tcells[int(idx[i])]
                if w == 0:
                    drop.append(i)
                    continue
                F[i], G[i], wid[i] = fg, bgc, w
                chi[i] = len(chars)
                chars.append(ch)
            if drop:
                keep = np.ones(idx.size, bool)
                keep[drop] = False
                idx, F, G, chi, wid = idx[keep], F[keep], G[keep], chi[keep], wid[keep]
        n = idx.size
        W = s.cols
        row = idx // W
        jump = np.ones(n, bool)
        jump[1:] = (row[1:] != row[:-1]) | (idx[1:] != idx[:-1] + wid[:-1])
        newrow = np.ones(n, bool)
        newrow[1:] = row[1:] != row[:-1]
        ar = np.arange(n)

        def need(V):
            last = np.maximum.accumulate(np.where(V >= 0, ar, -1))
            pl = np.empty(n, np.int64)
            pl[0] = -1
            pl[1:] = last[:-1]
            return (V >= 0) & (V != np.where(pl >= 0, V[np.maximum(pl, 0)], -2))

        parts = np.array(chars, dtype=object)[chi]
        for V, cache, bg in ((G, s.bgc, 1), (F, s.fgc, 0)):
            sel = np.flatnonzero(need(V))
            if sel.size:
                u, inv = np.unique(V[sel], return_inverse=True)
                es = [cache[k] if k in cache else (s.bg0 if bg and k == 0 else s.esc(k, bg)) for k in u.tolist()]
                parts[sel] = np.array(es, dtype=object)[inv] + parts[sel]
        js = np.flatnonzero(jump)
        if js.size:
            cols = (idx[js] % W + 1).tolist()
            rows = (row[js] + 1).tolist()
            nr = newrow[js].tolist()
            parts[js] = np.array(["\x1b[%d;%dH" % (r, x) if f else "\x1b[%dG" % x for r, x, f in zip(rows, cols, nr)],
                                 dtype=object) + parts[js]
        if len(s.fgc) + len(s.bgc) > 300000:
            s.fgc.clear()
            s.bgc.clear()
        s.write("\x1b[?2026h" + "".join(parts.tolist()) + "\x1b[0m\x1b[?2026l")


def box_blur(a, r):
    # separable box blur with clamped edges (two calls approximate a gaussian)
    if r < 1:
        return a
    n = 2 * r + 1
    c = np.cumsum(np.pad(a, ((r + 1, r), (0, 0)) + ((0, 0),) * (a.ndim - 2), mode="edge"), 0)
    a = (c[n:] - c[:-n]) / n
    c = np.cumsum(np.pad(a, ((0, 0), (r + 1, r)) + ((0, 0),) * (a.ndim - 2), mode="edge"), 1)
    return (c[:, n:] - c[:, :-n]) / n


def bloom(img, thr, r, k):
    # glow around bright parts: blur a half resolution bright pass and add it back
    H, W = img.shape[:2]
    b = np.maximum(img[: H & ~1, : W & ~1] - thr, 0)
    b = (b[0::2, 0::2] + b[1::2, 0::2] + b[0::2, 1::2] + b[1::2, 1::2]) * 0.25
    r = max(1, r // 2)
    b = box_blur(box_blur(b, r), r).repeat(2, 0).repeat(2, 1)
    out = img.copy()
    out[: H & ~1, : W & ~1] += k * b
    return out


def soft(img, r):
    # cheap wide blur: half resolution box blur, upsampled
    H, W = img.shape[:2]
    b = img[: H & ~1, : W & ~1]
    b = (b[0::2, 0::2] + b[1::2, 0::2] + b[0::2, 1::2] + b[1::2, 1::2]) * 0.25
    r = max(1, r // 2)
    b = box_blur(box_blur(b, r), r).repeat(2, 0).repeat(2, 1)
    out = np.zeros_like(img)
    out[: H & ~1, : W & ~1] = b
    return out


def tonemap(img, exposure=1.0):
    return 1.0 - np.exp(-np.maximum(img, 0) * exposure)


def ntab(seed):
    return np.random.default_rng(seed).random(4096).astype(np.float32)


def _hsh(a, b, c=0):
    h = a * 374761393 + b * 668265263 + c * 1440662683
    h = (h ^ (h >> 13)) * 1274126177
    return (h ^ (h >> 16)) & 4095


def noise2(tab, x, y, px=0, py=0):
    # value noise in [0, 1], optionally periodic with integer periods px / py
    xi, yi = np.floor(x), np.floor(y)
    fx, fy = x - xi, y - yi
    x0, y0 = xi.astype(np.int64), yi.astype(np.int64)
    x1, y1 = x0 + 1, y0 + 1
    if px:
        x0, x1 = x0 % px, x1 % px
    if py:
        y0, y1 = y0 % py, y1 % py
    ux, uy = fx * fx * (3 - 2 * fx), fy * fy * (3 - 2 * fy)
    a, b, c, d = tab[_hsh(x0, y0)], tab[_hsh(x1, y0)], tab[_hsh(x0, y1)], tab[_hsh(x1, y1)]
    return a + (b - a) * ux + (c - a + (a - b + d - c) * ux) * uy


def fbm2(tab, x, y, octaves=5, px=0, py=0, gain=0.5):
    tot, amp, norm = 0.0, 1.0, 0.0
    for o in range(octaves):
        f = 1 << o
        tot = tot + amp * noise2(tab, x * f + o * 17.3, y * f + o * 9.1, px * f, py * f)
        norm += amp
        amp *= gain
    return tot / norm


def noise3(tab, x, y, z):
    xi, yi, zi = np.floor(x), np.floor(y), np.floor(z)
    fx, fy, fz = x - xi, y - yi, z - zi
    x0, y0, z0 = xi.astype(np.int64), yi.astype(np.int64), zi.astype(np.int64)
    ux, uy, uz = fx * fx * (3 - 2 * fx), fy * fy * (3 - 2 * fy), fz * fz * (3 - 2 * fz)
    r = []
    for dz in (0, 1):
        a, b = tab[_hsh(x0, y0, z0 + dz)], tab[_hsh(x0 + 1, y0, z0 + dz)]
        c, d = tab[_hsh(x0, y0 + 1, z0 + dz)], tab[_hsh(x0 + 1, y0 + 1, z0 + dz)]
        r.append(a + (b - a) * ux + (c - a + (a - b + d - c) * ux) * uy)
    return r[0] + (r[1] - r[0]) * uz


def fbm3(tab, x, y, z, octaves=5, gain=0.5, ridged=False):
    tot, amp, norm = 0.0, 1.0, 0.0
    for o in range(octaves):
        f = float(1 << o)
        n = noise3(tab, x * f + o * 3.7, y * f - o * 5.3, z * f + o * 1.9)
        if ridged:
            n = 1.0 - np.abs(2.0 * n - 1.0)
            n = n * n
        tot = tot + amp * n
        norm += amp
        amp *= gain
    return tot / norm


def ramp(stops, t):
    # piecewise linear color ramp: stops = [(pos, (r, g, b)), ...] sorted by pos, t: array -> (..., 3)
    pos = np.array([p for p, _ in stops], np.float32)
    cols = np.array([c for _, c in stops], np.float32)
    t = np.clip(t, pos[0], pos[-1])
    return np.stack([np.interp(t, pos, cols[:, i]) for i in range(3)], -1).astype(np.float32)


def smooth(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3 - 2 * t)


def blackbody(t):
    # rough color of a black body, t in kelvin / 1000 (array), normalized to max channel 1
    t = np.clip(t, 1.0, 40.0)
    hot = np.maximum(t * 10 - 60, 1e-3)
    r = np.where(t < 6.6, 1.0, np.clip(1.292936 * hot ** -0.1332047, 0, 1))
    g = np.where(t < 6.6, np.clip(0.390082 * np.log(t * 10) - 0.631841, 0, 1),
                 np.clip(1.129891 * hot ** -0.0755148, 0, 1))
    b = np.where(t >= 6.6, 1.0, np.where(t < 1.9, 0.0, np.clip(0.543207 * np.log(np.maximum(t * 10 - 10, 1e-3)) - 1.196254, 0, 1)))
    return np.stack([r, g, b], -1).astype(np.float32)


SPEC_F2 = {}


def specnoise(h, w, beta, rng, aniso=1.0, lo=0.0):
    # gaussian random field with a 1/f^beta power spectrum (periodic), zero mean, unit variance
    key = (h, w, aniso)
    f2 = SPEC_F2.get(key)
    if f2 is None:
        fy = (np.fft.fftfreq(h) * aniso).astype(np.float32)[:, None]
        fx = np.fft.rfftfreq(w).astype(np.float32)[None, :]
        f2 = fx * fx + fy * fy
        f2[0, 0] = 1.0
        SPEC_F2.clear()
        SPEC_F2[key] = f2
    amp = f2 ** np.float32(-beta / 4.0)
    if lo:
        amp *= 1 - np.exp(-f2 / np.float32(lo * lo))
    amp[0, 0] = 0
    re_ = rng.standard_normal(amp.shape, dtype=np.float32)
    im_ = rng.standard_normal(amp.shape, dtype=np.float32)
    n = np.fft.irfft2((re_ * amp) + 1j * (im_ * amp), s=(h, w))
    return ((n - n.mean()) / (n.std() + 1e-12)).astype(np.float32)


def specnoise1(n, beta, rng):
    f = np.fft.rfftfreq(n)
    f[0] = 1.0
    amp = f ** (-beta / 2.0)
    amp[0] = 0
    x = np.fft.irfft(amp * (rng.standard_normal(f.size) + 1j * rng.standard_normal(f.size)), n)
    return ((x - x.mean()) / (x.std() + 1e-12)).astype(np.float32)


def hsv(h, s_, v):
    # vectorised hsv -> rgb, h in turns
    h = (np.asarray(h) % 1.0) * 6
    i = np.floor(h).astype(int) % 6
    f = h - np.floor(h)
    p, q, t = v * (1 - s_), v * (1 - s_ * f), v * (1 - s_ * (1 - f))
    r = np.choose(i, [v, q, p, p, t, v])
    g = np.choose(i, [t, v, v, q, p, p])
    b = np.choose(i, [p, p, t, v, v, q])
    return np.stack([r, g, b], -1).astype(np.float32)


def rotx(a):
    c, s_ = math.cos(a), math.sin(a)
    return np.array([[1, 0, 0], [0, c, -s_], [0, s_, c]])


def rotz(a):
    c, s_ = math.cos(a), math.sin(a)
    return np.array([[c, -s_, 0], [s_, c, 0], [0, 0, 1]])


def unit(*v):
    v = np.array(v, float)
    return v / np.linalg.norm(v)


def rd(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def box(scr, y, x, h, w, title="", attr=None):
    if h < 2 or w < 4:
        return
    a = col(CYAN) if attr is None else attr
    put(scr, y, x, "┌" + "─" * (w - 2) + "┐", a)
    for i in range(1, h - 1):
        put(scr, y + i, x, "│", a)
        put(scr, y + i, x + w - 1, "│", a)
    put(scr, y + h - 1, x, "└" + "─" * (w - 2) + "┘", a)
    if title:
        put(scr, y, x + 2, " " + title + " ", col(YELLOW) | BOLD)


BR = {(0, 0): 0x01, (0, 1): 0x02, (0, 2): 0x04, (1, 0): 0x08, (1, 1): 0x10, (1, 2): 0x20, (0, 3): 0x40, (1, 3): 0x80}


def popcount(x):
    return x.bit_count() if hasattr(x, "bit_count") else bin(x).count("1")


class Canvas:
    def __init__(s, w, h):
        s.w, s.h = w, h
        s.W, s.H = w * 2, h * 4
        s.cells = {}

    def dot(s, x, y, a):
        if 0 <= x < s.W and 0 <= y < s.H:
            k = (x >> 1, y >> 2)
            m = BR[(x & 1, y & 3)]
            o = s.cells.get(k)
            s.cells[k] = ((o[0] | m) if o else m, a)

    def line(s, x0, y0, x1, y1, a):
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        dx, dy = (x1 - x0) / n, (y1 - y0) / n
        for i in range(n + 1):
            s.dot(int(round(x0 + dx * i)), int(round(y0 + dy * i)), a)

    def flush(s, scr):
        addstr = scr.addstr
        for (cx, cy), (m, a) in s.cells.items():
            try:
                addstr(cy, cx, chr(0x2800 + m), a)
            except curses.error:
                pass


class Painter(Canvas):
    def __init__(s, w, h):
        Canvas.__init__(s, w, h)
        s.touched = set()

    def dot(s, x, y, a):
        if 0 <= x < s.W and 0 <= y < s.H:
            k = (x >> 1, y >> 2)
            m = BR[(x & 1, y & 3)]
            o = s.cells.get(k)
            s.cells[k] = ((o[0] | m) if o else m, a)
            s.touched.add(k)

    def flush(s, scr):
        addstr = scr.addstr
        for k in s.touched:
            m, a = s.cells[k]
            try:
                addstr(k[1], k[0], chr(0x2800 + m), a)
            except curses.error:
                pass
        s.touched.clear()


KATA = [chr(c) for c in range(0xFF66, 0xFF9E)]
SAFE_GLYPHS = (list("0123456789") * 2 + list("ΓΔΘΛΞΠΣΦΨΩαβγδεζηθλμξπρστφψω") + list("ЖЦЧШЩЭЮЯжцчшщэюяфиы")
               + list("∂∆∏∑√∞∩∫≈≠≡≤≥") + list("ßþðæøÞÐÆØ¥£¢¤§¶†‡¦¬±×÷"))
ASCII_GLYPHS = list("0123456789ABCDEFabcdef:=*+-<>|$#@%&")


def glyph_set():
    mode = os.environ.get("NERDSAVER_GLYPHS", "safe").lower()
    if mode == "katakana":
        return KATA * 3 + list("0123456789:=*+-<>|")
    if mode == "ascii":
        return ASCII_GLYPHS
    return SAFE_GLYPHS


GLYPHS = glyph_set()


class Matrix:
    fps = 15

    def __init__(s, scr):
        s.scr = scr
        s.h, s.w = scr.getmaxyx()
        s.pal = mkpal(MAT, GREEN)
        s.cols = [s.spawn(True) for _ in range(s.w)]

    def spawn(s, first=False):
        h, pal = s.h, s.pal
        n = random.randint(max(5, h // 5), max(8, int(h * 0.9)))
        y = random.uniform(-h, 2 * h) if first else h + random.uniform(0, 1.5 * h)
        a = [pal[min(len(pal) - 1, int(i / n * len(pal)))] for i in range(n)]
        a[0] |= BOLD
        return [y, random.uniform(4.0, 15.0), n, [random.choice(GLYPHS) for _ in range(h + 1)], a]

    def step(s, dt):
        scr, h, cols = s.scr, s.h, s.cols
        scr.erase()
        addstr = scr.addstr
        for x, c in enumerate(cols):
            c[0] -= c[1] * dt
            head, n = int(c[0]), c[2]
            if head + n < 0:
                cols[x] = s.spawn()
                continue
            lo, hi = max(0, -head), min(n, h - head)
            if hi <= lo:
                continue
            g, a = c[3], c[4]
            if random.random() < 0.5:
                g[head + random.randrange(lo, hi)] = random.choice(GLYPHS)
            for i in range(lo, hi):
                try:
                    addstr(head + i, x, g[head + i], a[i])
                except curses.error:
                    pass


DISK_RE = re.compile(r"^(sd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme\d+n\d+|mmcblk\d+)$")


def read_cpu():
    out = []
    for line in rd("/proc/stat").splitlines():
        if line.startswith("cpu"):
            p = line.split()
            v = list(map(int, p[1:9]))
            out.append((v[3] + v[4], sum(v)))
    return out


def read_mem():
    d = {}
    for line in rd("/proc/meminfo").splitlines():
        k, _, v = line.partition(":")
        try:
            d[k] = int(v.split()[0])
        except (ValueError, IndexError):
            pass
    return d


def read_net():
    rx = tx = 0
    for line in rd("/proc/net/dev").splitlines()[2:]:
        name, _, data = line.partition(":")
        if name.strip() == "lo":
            continue
        f = data.split()
        try:
            rx += int(f[0])
            tx += int(f[8])
        except (ValueError, IndexError):
            pass
    return rx, tx


def read_disk():
    r = w = 0
    for line in rd("/proc/diskstats").splitlines():
        f = line.split()
        if len(f) > 9 and DISK_RE.match(f[2]):
            r += int(f[5])
            w += int(f[9])
    return r * 512, w * 512


def read_bat(d):
    if not d:
        return None
    try:
        cap = int(rd(d + "/capacity")) / 100.0
    except ValueError:
        return None
    st = rd(d + "/status").strip()
    eta = None
    for now_f, full_f, rate_f in (("energy_now", "energy_full", "power_now"), ("charge_now", "charge_full", "current_now")):
        try:
            rate = int(rd("%s/%s" % (d, rate_f)))
            if rate > 0:
                now_v = int(rd("%s/%s" % (d, now_f)))
                if st == "Discharging":
                    eta = now_v / rate
                elif st == "Charging":
                    eta = (int(rd("%s/%s" % (d, full_f))) - now_v) / rate
                break
        except ValueError:
            pass
    return cap, st, eta


def read_temp(files):
    t = []
    for f in files:
        try:
            t.append(int(rd(f)) / 1000.0)
        except ValueError:
            pass
    return max(t) if t else None


def read_freq(files):
    t = []
    for f in files:
        try:
            t.append(int(rd(f)) / 1e6)
        except ValueError:
            pass
    return t


def read_procs():
    d = {}
    try:
        pids = os.listdir("/proc")
    except OSError:
        return d
    for pid in pids:
        if not pid.isdigit():
            continue
        st = rd("/proc/%s/stat" % pid)
        r = st.rfind(")")
        if r < 0:
            continue
        try:
            f = st[r + 2:].split()
            d[pid] = (st[st.find("(") + 1:r], int(f[11]) + int(f[12]))
        except (ValueError, IndexError):
            pass
    return d


def rss_mb(pid, page):
    try:
        return int(rd("/proc/%s/statm" % pid).split()[1]) * page / 1048576.0
    except (ValueError, IndexError):
        return 0.0


def spark(vals, width, vmax=None):
    vals = list(vals)[-width:]
    vmax = vmax or max(max(vals, default=0), 1e-9)
    return "".join(SPARK[min(7, int(v / vmax * 7.999))] for v in vals).rjust(width)


def human(n):
    for u in ("B/s", "KB/s", "MB/s", "GB/s"):
        if n < 1024:
            return "%6.1f %s" % (n, u)
        n /= 1024.0
    return "%6.1f TB/s" % n


def hms(hours):
    return "%dh%02dm" % (int(hours), int(hours % 1 * 60))


class SysMon:
    fps = 8

    def __init__(s, scr):
        s.scr = scr
        u = os.uname()
        s.host, s.kernel = u.nodename, u.release
        s.tck = os.sysconf("SC_CLK_TCK")
        s.page = os.sysconf("SC_PAGE_SIZE")
        s.prev_cpu = read_cpu()
        s.nc = max(1, len(s.prev_cpu) - 1)
        s.cpu = [0.0] * (s.nc + 1)
        s.hist = deque(maxlen=400)
        s.disp = {}
        s.alpha = 0.3
        s.mem = s.swap = s.disk = 0.0
        s.memtxt = s.swaptxt = s.disktxt = ""
        bats = sorted(glob.glob("/sys/class/power_supply/BAT*"))
        s.bat_dir = bats[0] if bats else None
        s.therm = glob.glob("/sys/class/thermal/thermal_zone*/temp")
        s.freqf = [("/sys/devices/system/cpu/cpu%d/cpufreq/scaling_cur_freq" % i) for i in range(s.nc)]
        s.freq = []
        s.bat, s.temp = None, None
        s.up = 0.0
        s.load = (0.0, 0.0, 0.0)
        s.rx = s.tx = s.dr = s.dw = 0.0
        s.hist_n = {k: deque(maxlen=300) for k in ("rx", "tx", "dr", "dw")}
        s.prev_net, s.prev_disk = read_net(), read_disk()
        s.prev_proc = read_procs()
        s.procs = []
        s.last = s.slow = time.monotonic() - 2
        s.barp = mkpal(BARP, GREEN)
        s.heat = mkpal(HEAT, GREEN)
        s.lab = c256(51, CYAN) | BOLD
        s.empty = c256(238, WHITE) | DIM
        s.white = col(WHITE) | BOLD

    def sample(s, now):
        dt = max(now - s.last, 1e-3)
        s.last = now
        cur = read_cpu()
        if len(cur) == len(s.prev_cpu):
            s.cpu = [1 - (i - i0) / (t - t0) if t > t0 else 0.0 for (i, t), (i0, t0) in zip(cur, s.prev_cpu)]
            s.hist.append(s.cpu[0])
        s.prev_cpu = cur
        m = read_mem()
        tot, av = m.get("MemTotal", 1), m.get("MemAvailable", 0)
        s.mem = 1 - av / tot
        s.memtxt = "%.1f/%.1fG" % ((tot - av) / 1048576, tot / 1048576)
        st, sf = m.get("SwapTotal", 0), m.get("SwapFree", 0)
        s.swap = (1 - sf / st) if st else 0.0
        s.swaptxt = "%.1f/%.1fG" % ((st - sf) / 1048576, st / 1048576)
        try:
            du = shutil.disk_usage("/")
            s.disk = du.used / du.total
            s.disktxt = "%.0f/%.0fG" % (du.used / 2 ** 30, du.total / 2 ** 30)
        except OSError:
            pass
        try:
            s.load = os.getloadavg()
            s.up = float(rd("/proc/uptime").split()[0])
        except (OSError, ValueError, IndexError):
            pass
        rx, tx = read_net()
        dr, dw = read_disk()
        s.rx, s.tx = (rx - s.prev_net[0]) / dt, (tx - s.prev_net[1]) / dt
        s.dr, s.dw = (dr - s.prev_disk[0]) / dt, (dw - s.prev_disk[1]) / dt
        s.prev_net, s.prev_disk = (rx, tx), (dr, dw)
        for k, v in (("rx", s.rx), ("tx", s.tx), ("dr", s.dr), ("dw", s.dw)):
            s.hist_n[k].append(max(0.0, v))
        if now - s.slow >= 2.0:
            dts = now - s.slow
            s.slow = now
            s.bat = read_bat(s.bat_dir)
            s.temp = read_temp(s.therm)
            s.freq = read_freq(s.freqf)
            pr = read_procs()
            lst = [(pid, name, (tt - s.prev_proc[pid][1]) / s.tck / dts)
                   for pid, (name, tt) in pr.items() if pid in s.prev_proc]
            s.prev_proc = pr
            lst.sort(key=lambda z: -z[2])
            s.procs = [(n, c, rss_mb(p, s.page)) for p, n, c in lst[:14]]

    def sm(s, key, target):
        v = s.disp.get(key, 0.0)
        v += (target - v) * s.alpha
        s.disp[key] = v
        return v

    def bar(s, y, x, wid, val, label, suffix=""):
        scr = s.scr
        put(scr, y, x, "%-5s" % label, s.lab)
        inner = wid - 8 - len(suffix)
        if inner < 4:
            return
        val = min(1.0, max(0.0, val))
        n = int(val * inner)
        put(scr, y, x + 5, "[", s.white)
        k = len(s.barp)
        for i in range(k):
            a, b = int(i * inner / k), min(n, int((i + 1) * inner / k))
            if b > a:
                put(scr, y, x + 6 + a, "█" * (b - a), s.barp[i])
        if n < inner:
            put(scr, y, x + 6 + n, "░" * (inner - n), s.empty)
        put(scr, y, x + 6 + inner, "]", s.white)
        put(scr, y, x + 8 + inner, suffix, col(WHITE))

    def graph(s, y, x, h, w, data):
        data = list(data)[-w:]
        pad = w - len(data)
        units = [int(max(0.0, min(1.0, v)) * h * 8) for v in data]
        for r in range(h):
            line = "".join("█" if u >= (r + 1) * 8 else SPARK[u - r * 8 - 1] if u > r * 8 else " " for u in units)
            put(s.scr, y + h - 1 - r, x + pad, line, pick(s.heat, (r + 0.5) / h))

    def io_line(s, y, x, wid, label, rate, key, attr):
        put(s.scr, y, x, label, attr | BOLD)
        put(s.scr, y, x + 5, human(rate), attr | BOLD)
        sw = wid - 16
        if sw > 3:
            put(s.scr, y, x + 16, spark(s.hist_n[key], sw), attr)

    def step(s, dt):
        now = time.monotonic()
        s.alpha = 1 - math.exp(-dt * 7)
        if now - s.last >= 1.0:
            s.sample(now)
        scr = s.scr
        scr.erase()
        h, w = scr.getmaxyx()
        up = s.up
        put(scr, 0, 0, " ▓▒░ %s ░▒▓  kernel %s " % (s.host, s.kernel), c256(46, GREEN) | BOLD)
        clock = time.strftime(" %a %Y-%m-%d %H:%M:%S ")
        put(scr, 0, max(0, w - len(clock)), clock, c256(51, CYAN) | BOLD)
        p = abs(((now * 28) % (2 * w)) - w)
        put(scr, 1, int(p), "░▒▓█▓▒░", c256(28, GREEN))

        lw = w // 2
        rw = w - lw
        ch_ = min(s.nc + 3, max(5, (h - 2) // 2))
        box(scr, 2, 0, ch_, lw, "CPU  %d threads" % s.nc)
        for i in range(ch_ - 2):
            if i >= len(s.cpu):
                break
            v = s.sm("c%d" % i, s.cpu[i])
            tail = "%5.1f%%" % (v * 100)
            if i > 0 and i - 1 < len(s.freq):
                tail += " %.1fG" % s.freq[i - 1]
            s.bar(3 + i, 2, lw - 4, v, "ALL" if i == 0 else "cpu%d" % (i - 1), tail)
        gh = h - (2 + ch_)
        if gh >= 4:
            box(scr, 2 + ch_, 0, gh, lw, "CPU history (%ds)" % (lw - 2))
            s.graph(3 + ch_, 1, gh - 2, lw - 2, s.hist)

        x, wd = lw, rw
        box(scr, 2, x, 9, wd, "memory / power / thermal")
        s.bar(3, x + 2, wd - 4, s.sm("mem", s.mem), "MEM", s.memtxt)
        s.bar(4, x + 2, wd - 4, s.sm("swap", s.swap), "SWAP", s.swaptxt)
        s.bar(5, x + 2, wd - 4, s.sm("disk", s.disk), "DISK/", s.disktxt)
        if s.bat is None:
            put(scr, 6, x + 2, "BAT  AC power, no battery found", col(YELLOW))
        else:
            cap, st, eta = s.bat
            sym = {"Charging": "⚡", "Discharging": "▼", "Full": "✔"}.get(st, "?")
            tail = "%3d%% %s" % (cap * 100, sym) + (" " + hms(eta) if eta else "")
            s.bar(6, x + 2, wd - 4, s.sm("bat", cap), "BAT", tail)
        if s.temp is None:
            put(scr, 7, x + 2, "TEMP n/a", col(YELLOW))
        else:
            s.bar(7, x + 2, wd - 4, s.sm("tmp", s.temp / 100.0), "TEMP", "%4.0f°C" % s.temp)
        put(scr, 8, x + 2, "LOAD  %.2f %.2f %.2f   UP %dd %02dh %02dm" %
            (s.load[0], s.load[1], s.load[2], up // 86400, up % 86400 // 3600, up % 3600 // 60), s.white)

        box(scr, 11, x, 6, wd, "network / disk i/o")
        s.io_line(12, x + 2, wd - 4, "RX ▼", s.rx, "rx", c256(46, GREEN))
        s.io_line(13, x + 2, wd - 4, "TX ▲", s.tx, "tx", c256(207, MAGENTA))
        s.io_line(14, x + 2, wd - 4, "RD ◀", s.dr, "dr", c256(45, CYAN))
        s.io_line(15, x + 2, wd - 4, "WR ▶", s.dw, "dw", c256(214, YELLOW))

        ph = h - 17
        if ph >= 4:
            box(scr, 17, x, ph, wd, "top processes")
            for i, (name, cp, mb) in enumerate(s.procs[: ph - 2]):
                v = s.sm("p%d" % i, min(1.0, cp / max(1, s.nc)))
                s.bar(18 + i, x + 2, wd - 4, v, name[:5], "%5.1f%% %5.0fM" % (cp * 100, mb))


def escape_grid(w, h, cx, cy, sy, c, maxit, off, pal_len, ship):
    sx = sy * 0.5
    stride = 1 if np is not None else 2
    wc = (w + stride - 1) // stride
    sxc = sx * stride
    ramp = len(Fractal.RAMP) - 1
    if np is not None:
        xs = cx + (np.arange(wc) - wc / 2) * sxc
        ys = (cy - (np.arange(h) - h / 2) * sy) if ship else (cy + (np.arange(h) - h / 2) * sy)
        z0 = (xs[None, :] + 1j * ys[:, None]).ravel()
        cc = np.full(z0.shape, c, dtype=np.complex128) if c is not None else z0.copy()
        nu = np.full(z0.shape, -1.0)
        idx = np.arange(z0.size)
        z = z0.copy()
        for i in range(maxit):
            if ship:
                z = np.abs(z.real) + 1j * np.abs(z.imag)
            z = z * z + cc
            m2 = z.real * z.real + z.imag * z.imag
            esc = m2 > 4.0
            if esc.any():
                nu[idx[esc]] = i + 1 - np.log2(np.log2(np.sqrt(m2[esc])))
                keep = ~esc
                idx, z, cc = idx[keep], z[keep], cc[keep]
                if idx.size == 0:
                    break
        inside = nu < 0
        colors = np.where(inside, -1, ((nu * 1.2 + off) % pal_len).astype(np.int64))
        chars = np.where(inside, 0, (((nu % 1.0) * ramp).astype(np.int64) + 1))
        return colors.reshape(h, wc).tolist(), chars.reshape(h, wc).tolist(), stride
    colors, chars = [], []
    for j in range(h):
        im = (cy - (j - h / 2) * sy) if ship else (cy + (j - h / 2) * sy)
        rc, rh = [], []
        for i in range(wc):
            z = complex(cx + (i - wc / 2) * sxc, im)
            k = z if c is None else c
            n = 0
            while n < maxit:
                if ship:
                    z = complex(abs(z.real), abs(z.imag))
                z = z * z + k
                if z.real * z.real + z.imag * z.imag > 4.0:
                    break
                n += 1
            if n >= maxit:
                rc.append(-1)
                rh.append(0)
            else:
                v = n + 1 - math.log2(math.log2(math.sqrt(z.real * z.real + z.imag * z.imag)))
                rc.append(int(v * 1.2 + off) % pal_len)
                rh.append(int((v % 1.0) * ramp) + 1)
        colors.append(rc)
        chars.append(rh)
    return colors, chars, stride


class Fractal:
    RAMP = " .:-=+*#%@"
    MODES = ("julia", "mandelbrot", "ship")
    LIMITS = {"julia": 40, "mandelbrot": 60, "ship": 50}

    def __init__(s, scr):
        s.scr = scr
        s.fps = 8 if np is not None else 3
        s.pal = mkpal(FRAC, CYAN)
        s.t = random.uniform(0, 6)
        s.mode = random.randrange(3)
        s.start()

    def start(s):
        s.mt = time.monotonic()
        s.scale = 3.0 if s.mode != 2 else 2.4

    def step(s, dt):
        scr = s.scr
        h, w = scr.getmaxyx()
        hh = max(2, h)
        now = time.monotonic()
        mode = s.MODES[s.mode]
        if now - s.mt > s.LIMITS[mode]:
            s.mode = (s.mode + 1) % 3
            s.start()
            mode = s.MODES[s.mode]
        s.t += 0.45 * dt
        off = s.t * 4
        n = len(s.pal)
        if mode == "julia":
            a = s.t * 0.3
            c = 0.7885 * complex(math.cos(a), math.sin(a))
            colors, chars, stride = escape_grid(w, hh, 0.0, 0.0, 2.8 / hh, c, 56, off, n, False)
        elif mode == "mandelbrot":
            s.scale = max(s.scale * math.exp(-0.2 * dt), 4e-5)
            maxit = min(240, int(50 + 45 * math.log10(3.0 / s.scale)))
            colors, chars, stride = escape_grid(w, hh, -0.743643887037151, 0.131825904205330, s.scale / hh,
                                                None, maxit, off, n, False)
        else:
            s.scale = max(s.scale * math.exp(-0.165 * dt), 2.5e-3)
            maxit = min(200, int(50 + 40 * math.log10(2.4 / s.scale)))
            colors, chars, stride = escape_grid(w, hh, -1.7443359375, -0.017451171875, s.scale / hh,
                                                None, maxit, off, n, True)
        scr.erase()
        ramp = s.RAMP
        for y in range(hh):
            rc, rh = colors[y], chars[y]
            for key, grp in itertools.groupby(range(len(rc)), key=rc.__getitem__):
                if key >= 0:
                    idxs = list(grp)
                    put(scr, y, idxs[0] * stride, "".join(ramp[rh[i]] * stride for i in idxs), s.pal[key] | BOLD)


