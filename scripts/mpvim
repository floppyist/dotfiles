#!/usr/bin/env python3
"""mpvim - Vim-gesteuertes Terminal-Frontend fuer mpv (Audio).

Installation:
    ./install.sh                                  # verlinkt scripts/mpvim nach ~/.local/bin/mpvim
    .bashrc enthaelt bereits: alias mpv='mpvim'   # eigene Aliase dort ergaenzen

Benutzung:
    cd audio && mpvim .        # Ordner (rekursiv)
    mpvim *                    # Dateien / Ordner
    mpvim --shuffle *.flac     # Optionen mit -- werden an mpv durchgereicht

Hilfe im Programm: F1 oder :help
"""
