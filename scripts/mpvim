# ---------------------------------------------------------------- Helfer
def cw(ch):
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in "WF" else 1


def sw(s):
    return sum(cw(c) for c in s)


def clip(s, w):
    out, n = [], 0
    for c in s:
        k = cw(c)
        if n + k > w:
            break
        out.append(c)
        n += k
    return "".join(out)


def trunc(s, w):
    if sw(s) <= w:
        return s
    return clip(s, max(0, w - 1)) + "\u2026" if w > 0 else ""


def clean(s):
    return "".join(c if c.isprintable() else "?" for c in s)


def fmt_time(t):
    if t is None:
        return "--:--"
    t = int(t)
    h, r = divmod(t, 3600)
    m, s = divmod(r, 60)
    return f"{h}:{m:02}:{s:02}" if h else f"{m:02}:{s:02}"


def natkey(s):
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", s)]


def is_url(p):
    return re.match(r"^[a-zA-Z][\w+.-]*://", p) is not None


def collect(paths):
    out = []
    for p in paths:
        p = os.path.expanduser(p)
        if is_url(p):
            out.append(p)
        elif os.path.isdir(p):
            for root, dirs, files in os.walk(p):
                dirs[:] = sorted((d for d in dirs if not d.startswith(".")), key=natkey)
                for f in sorted(files, key=natkey):
                    if not f.startswith(".") and os.path.splitext(f)[1].lower() in AUDIO_EXT:
                        out.append(os.path.abspath(os.path.join(root, f)))
        elif os.path.exists(p):
            out.append(os.path.abspath(p))
    return out


def disp(fn):
    if is_url(fn):
        return clean(fn)
    rp = os.path.relpath(fn)
    if rp.startswith(".."):
        rp = os.path.join(os.path.basename(os.path.dirname(fn)), os.path.basename(fn))
    return clean(os.path.splitext(rp)[0])


def on(v):
    return v not in (None, False, "no", 0, "0")


def match(name, query):
    nl = name.lower()
    return all(w in nl for w in query.lower().split())


# ---------------------------------------------------------------- Zeichnen
def put(s, y, x, text, attr=0):
    h, w = s.getmaxyx()
    if y < 0 or y >= h or x < 0 or x >= w or not text:
        return
    try:
        s.addstr(y, x, clip(text, w - x), attr)
    except curses.error:
        pass  # rechte untere Ecke wirft Fehler, Zeichen wird trotzdem gesetzt


def draw_box(s, y, x, h, w, segs, battr):
    if h < 2 or w < 6:
        return
    put(s, y, x, "\u250c\u2500 ", battr)
    cx = x + 3
    for text, attr in segs:
        put(s, y, cx, text, attr)
        cx += sw(text)
    put(s, y, cx, " ", battr)
    cx += 1
    rem = x + w - 1 - cx
    if rem > 0:
        put(s, y, cx, "\u2500" * rem, battr)
    put(s, y, x + w - 1, "\u2510", battr)
    for r in range(1, h - 1):
        put(s, y + r, x, "\u2502", battr)
        put(s, y + r, x + w - 1, "\u2502", battr)
    put(s, y + h - 1, x, "\u2514" + "\u2500" * (w - 2) + "\u2518", battr)


def theme_path():
    return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                        "dotfiles", "theme.sh")


def theme_accent():
    """ANSI number of the accent from dotfiles.conf (bright variant, 9..14); 9 = red."""
    try:
        with open(theme_path(), encoding="utf-8") as f:
            for line in f:
                m = re.match(r"DF_ACCENT_ANSI_BRIGHT=([0-9]+)$", line.strip())
                if m and 9 <= int(m.group(1)) <= 14:
                    return int(m.group(1))
    except OSError:
        pass
    return 9


def make_attrs():
    # The terminal's 16 palette colors: alacritty.toml maps them to the desktop palette, so
    # mpvim matches the rest of the desktop (and still works in 8-color terminals).
    curses.start_color()
    curses.use_default_colors()
    many = curses.COLORS >= 16

    def c(n):
        return n if many or n < 8 else n - 8

    surface, muted, subtle, text = 0, (8 if many else 7), 7, c(15)
    red, green, yellow, blue, aqua = c(9), c(10), c(11), c(12), c(14)
    accent = c(theme_accent())
    fgs = {"border": muted, "title": subtle, "accent": accent, "text": text, "dim": muted,
           "label": subtle, "red": red, "teal": aqua, "blue": blue, "green": green,
           "yellow": yellow, "bright": text, "active": subtle}
    A = {}
    n = 0
    for name, fg in fgs.items():
        n += 1
        curses.init_pair(n, fg, -1)
        A[name] = curses.color_pair(n)
    # selection rows use the surface color like rofi; the accent bar marks the cursor row
    for name, fg, bg in (("sel", text, surface), ("selplay", accent, surface),
                         ("selbar", accent, surface), ("hit", surface, yellow)):
        n += 1
        curses.init_pair(n, fg, bg)
        A[name] = curses.color_pair(n)
    A["bold"] = A["bright"] | curses.A_BOLD
    A["head"] = A["accent"] | curses.A_BOLD
    A["play"] = A["accent"] | curses.A_BOLD
    A["selplay"] |= curses.A_BOLD
    A["sel"] |= curses.A_BOLD
    A["cursor"] = A["accent"] | curses.A_REVERSE
    A["dimcursor"] = A["dim"] | curses.A_REVERSE
    return A


# ---------------------------------------------------------------- Cover
# The cover is drawn with raw escape sequences into an area that curses keeps blank:
# curses never rewrites cells it believes unchanged (idcok is off, so it does not shift
# line contents either). When the area moves or the cover goes away, a full repaint
# (clearok) wipes the old pixels.
# Scrolling: when lines move (playlist, help), ncurses moves whole terminal lines with a
# scroll region (csr + newline) instead of redrawing them, and the cover pixels move along
# (torn cover). idlok(False) does not stop that, and there is no switch for it, so mpvim
# starts curses with a private copy of $TERM's terminfo without the scroll capabilities
# (no_scroll_terminfo): ncurses then only ever rewrites cells in place.
SCROLL_CAPS = re.compile(r"^\s+(csr|ind|indn|ri|rin|il|il1|dl|dl1|wind)=")


def no_scroll_terminfo(base):
    """Compile $TERM without its scroll capabilities into a new directory below base.
    Returns the directory (for $TERMINFO) or None (then curses runs with the original)."""
    term = os.environ.get("TERM", "")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]{0,63}", term):
        return None
    if not (shutil.which("infocmp") and shutil.which("tic")):
        return None
    try:
        src = subprocess.run(["infocmp", "-1x", "--", term], capture_output=True, text=True,
                             stdin=subprocess.DEVNULL, timeout=3)
        if src.returncode != 0 or "csr=" not in src.stdout:
            return None
        d = tempfile.mkdtemp(prefix="terminfo-", dir=base)
        f = os.path.join(d, "entry.src")
        with open(f, "w", encoding="utf-8") as fh:
            fh.write("\n".join(ln for ln in src.stdout.splitlines() if not SCROLL_CAPS.match(ln)) + "\n")
        r = subprocess.run(["tic", "-x", "-o", d, f], capture_output=True,
                           stdin=subprocess.DEVNULL, timeout=5)
        # initscr() exits the program when it cannot load the entry: make sure it is there
        if r.returncode != 0 or not any(os.path.isfile(os.path.join(d, sub, term))
                                        for sub in (term[0], f"{ord(term[0]):x}")):
            return None
        return d
    except (OSError, subprocess.SubprocessError, UnicodeError):
        return None


COVER_NAMES = ("cover", "folder", "front", "album", "albumart", "albumartsmall")
COVER_EXT = (".jpg", ".jpeg", ".png", ".webp", ".bmp")
SGR = re.compile(r"\x1b\[[0-9;:?]*[A-Za-z]")


def truecolor():
    if os.environ.get("COLORTERM", "").lower() in ("truecolor", "24bit"):
        return True
    return re.search(r"alacritty|kitty|wezterm|foot|ghostty|direct", os.environ.get("TERM", "")) is not None


def cover_data(path):
    """Embedded picture (ffmpeg) or an image next to the track; None if there is none."""
    if not path or is_url(path) or not os.path.isfile(path):
        return None
    if shutil.which("ffmpeg"):
        try:
            r = subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-i", path, "-map", "0:v:0?",
                                "-frames:v", "1", "-c:v", "png", "-f", "image2pipe", "-"],
                               stdin=subprocess.DEVNULL, capture_output=True, timeout=8)
            if r.returncode == 0 and r.stdout:
                return r.stdout
        except (OSError, subprocess.SubprocessError):
            pass
    d = os.path.dirname(os.path.abspath(path))
    try:
        imgs = [f for f in os.listdir(d) if os.path.splitext(f)[1].lower() in COVER_EXT]
    except OSError:
        return None
    named = sorted(f for f in imgs if os.path.splitext(f)[0].lower() in COVER_NAMES)
    # any other single image in the album folder is most likely the cover too
    pick = named[0] if named else (imgs[0] if len(imgs) == 1 else None)
    if not pick:
        return None
    try:
        with open(os.path.join(d, pick), "rb") as f:
            return f.read(32 * 1024 * 1024)
    except OSError:
        return None


def xterm256(rgb):
    r, g, b = (round(c / 255 * 5) for c in rgb)
    return 16 + 36 * r + 6 * g + b


def render_cover(data, cols, rows, tc):
    """[(ansi line, width in cells)] for an image: chafa if installed, else half blocks."""
    if shutil.which("chafa"):
        try:
            r = subprocess.run(["chafa", "--format", "symbols", "--size", f"{cols}x{rows}",
                                "--colors", "full" if tc else "256", "--polite", "on",
                                "--animate", "off", "-"],
                               input=data, capture_output=True, timeout=8)
            if r.returncode == 0 and r.stdout:
                lines = r.stdout.decode("utf-8", "replace").replace("\r", "").rstrip("\n").split("\n")
                return [(ln, sw(SGR.sub("", ln))) for ln in lines[:rows]]
        except (OSError, subprocess.SubprocessError):
            pass
    try:
        from PIL import Image
        im = Image.open(io.BytesIO(data)).convert("RGB")
    except Exception:
        return None
    scale = min(cols / im.width, rows * 2 / im.height)
    im = im.resize((max(1, round(im.width * scale)), max(1, round(im.height * scale))), Image.LANCZOS)
    w, h = im.size
    px = im.load()

    def color(rgb, base):
        if tc:
            return f"{base + 8};2;{rgb[0]};{rgb[1]};{rgb[2]}"
        return f"{base + 8};5;{xterm256(rgb)}"

    out = []
    for y in range(0, h, 2):
        parts, last = [], None
        for x in range(w):
            # upper half block: foreground = upper pixel, background = lower pixel
            bot = color(px[x, y + 1], 40) if y + 1 < h else "49"
            sgr = f"\x1b[{color(px[x, y], 30)};{bot}m"
            if sgr != last:
                parts.append(sgr)
                last = sgr
            parts.append("\u2580")
        out.append(("".join(parts) + "\x1b[0m", w))
    return out


class Covers:
    """Loads and renders covers in a background thread; draw() only looks results up."""

    def __init__(self):
        self.results = {}       # (path, cols, rows) -> rendered rows or None
        self.data = {}          # path -> image bytes or None
        self.pending = None
        self.busy = False
        self.lock = threading.Lock()
        self.tc = truecolor()

    def get(self, key):
        """Rendered rows, None (no cover) or False (not ready yet)."""
        with self.lock:
            if key in self.results:
                return self.results[key]
            self.pending = key
            if not self.busy:
                self.busy = True
                threading.Thread(target=self._work, daemon=True).start()
        return False

    def _work(self):
        while True:
            with self.lock:
                key, self.pending = self.pending, None
                if key is None or key in self.results:
                    if key is None:
                        self.busy = False
                        return
                    continue
            path, cols, rows = key
            if path not in self.data:
                self.data[path] = cover_data(path)
                while len(self.data) > 20:
                    self.data.pop(next(iter(self.data)))
            data = self.data[path]
            res = render_cover(data, cols, rows, self.tc) if data else None
            with self.lock:
                self.results[key] = res
                while len(self.results) > 40:
                    self.results.pop(next(iter(self.results)))


# ---------------------------------------------------------------- Dancer
# :dancer shows a dancing pixel-art sprite instead of the cover: by default the pumpkin goose
# of the fury engine (assets/mpvim/dancer.png in this repository, found through the real path of
# this script), MPVIM_DANCER=<png> picks another sheet. A sheet is an Aseprite export (PNG + JSON
# next to it with "frames" x/y/w/h, in order); without the JSON the PNG is one frame. Resampling filters smear pixel art (the 3 px faces turn to mud), so the sprite is
# shrunk by a vote per target pixel (the color covering most of it wins; outlines and rare
# detail colors such as the mouth get a bonus), and the eyes are taken out first and drawn
# again at the new size: crisp, with their highlight, and they can blink.
# The dance follows the track position (bpm tag, else 120 bpm) in a 16 beat routine: walk
# to and fro, wiggle, twirl, a big jump with a heart burst. Paused or stopped = asleep.
# Drawn like the cover (raw cells in an area curses keeps blank), but only rows that
# changed are rewritten, inside a synchronized update: no flicker at 15 frames per second.
DANCER_SHEET = os.path.normpath(os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                             "..", "assets", "mpvim", "dancer.png"))
DANCER_SCALES = (3, 2, 1, 0.75, 2 / 3, 0.6, 0.5, 0.4)
DANCER_BPM = 120
DANCER_JUMP = 2.0       # the big jump on beat 16, in hops
DANCER_LIFE = 3         # beats a heart or note floats
DANCER_FPS = 15
DANCER_COLORS = {"bg": "#191c1c", "overlay": "#313838", "accent_text": "#fb4934",
                 "purple_hi": "#d3869b", "yellow_hi": "#fabd2f", "aqua_hi": "#8ec07c",
                 "blue_hi": "#83a598", "bright": "#fbf1c7"}
N4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
# particle bitmaps: small ones next to a shrunk sprite, large ones from scale 1
BITMAPS = {
    "heart": (("##.##", "#####", ".###.", "..#.."),
              (".##.##.", "#######", "#######", ".#####.", "..###..", "...#...")),
    "note": (("..##", "..#.", "..#.", "###.", "##.."),
             ("...###", "...#.#", "...#..", "...#..", "####..", "####..", ".##...")),
    "notes": ((".####", ".#..#", ".#..#", "##.##", "##.##"),
              (".######", ".######", ".#...#.", ".#...#.", "##..##.", "###.###", "##..##.")),
    "spark": ((".#.", "###", ".#."), ("..#..", "..#..", "#####", "..#..", "..#..")),
    "z": (("###", ".#.", "###"), ("####", "..#.", ".#..", "####")),
    "Z": (("####", "..#.", ".#..", "####"), ("#####", "...#.", "..#..", ".#...", "#####")),
}


class DancerError(Exception):
    pass


def lum(c):
    return 0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2]


def blend(c, d, t):
    return tuple(round(a + (b - a) * t) for a, b in zip(c, d))


def prand(*vals):
    """Stable pseudo random number in [0, 1) for the given integers (FNV-1a)."""
    h = 2166136261
    for v in vals:
        h = ((h ^ (v & 0xFFFFFFFF)) * 16777619) & 0xFFFFFFFF
    h ^= h >> 15
    h = (h * 2246822519) & 0xFFFFFFFF
    return (h ^ (h >> 13)) / 2 ** 32


def theme_colors():
    """The dancer's colors from theme.sh (DF_* hex values), defaults without it."""
    hexes = dict(DANCER_COLORS)
    try:
        with open(theme_path(), encoding="utf-8") as f:
            for line in f:
                m = re.fullmatch(r"DF_([A-Z_]+)='?(#[0-9a-fA-F]{6})'?", line.strip())
                if m and m.group(1).lower() in hexes:
                    hexes[m.group(1).lower()] = m.group(2)
    except OSError:
        pass
    return {k: tuple(int(v[i:i + 2], 16) for i in (1, 3, 5)) for k, v in hexes.items()}


def dancer_path():
    return os.path.expanduser(os.environ.get("MPVIM_DANCER") or DANCER_SHEET)


def load_sheet(path):
    """Frames of a sprite sheet as rows of RGB tuples (None = transparent)."""
    try:
        from PIL import Image
    except ImportError:
        raise DancerError("dancer: needs python3-Pillow")
    try:
        im = Image.open(path)
        if im.width * im.height > 2048 * 2048:
            raise DancerError("dancer: sprite sheet too large")
        im = im.convert("RGBA")
    except DancerError:
        raise
    except Exception:
        raise DancerError(f"dancer: cannot load {path} (set MPVIM_DANCER)")
    W, H = im.size
    rects = []
    try:
        with open(os.path.splitext(path)[0] + ".json", encoding="utf-8") as f:
            frames = json.load(f).get("frames")
        # Aseprite writes "frames" as a list (array export) or an object (hash export)
        for item in (frames.values() if isinstance(frames, dict) else frames):
            r = item["frame"]
            rects.append(tuple(int(r[k]) for k in ("x", "y", "w", "h")))
    except (OSError, ValueError, TypeError, KeyError, AttributeError):
        rects = []
    rects = [r for r in rects if r[2] > 0 and r[3] > 0 and r[0] >= 0 and r[1] >= 0
             and r[0] + r[2] <= W and r[1] + r[3] <= H]
    rects = [r for r in rects if r[2:] == rects[0][2:]][:32] if rects else [(0, 0, W, H)]
    if rects[0][2] > 256 or rects[0][3] > 256:
        raise DancerError("dancer: frames larger than 256 px")
    px = im.load()
    return [[[px[x + i, y + j][:3] if px[x + i, y + j][3] >= 128 else None for i in range(w)]
             for j in range(h)] for x, y, w, h in rects]


def find_eyes(g):
    """Eyes: a light pixel (the highlight) with dark pixels on 3 or 4 sides, plus the dark
    pixels around it, all away from the outline (that rules out tips of wings and the like)."""
    H, W = len(g), len(g[0])

    def at(x, y):
        return g[y][x] if 0 <= x < W and 0 <= y < H else None

    def dark(p):
        c = at(*p)
        return c is not None and lum(c) < 48

    def edge(p):
        return any(at(p[0] + dx, p[1] + dy) is None for dx in (-1, 0, 1) for dy in (-1, 0, 1))

    eyes = []
    for y in range(H):
        for x in range(W):
            c = g[y][x]
            if c is None or lum(c) < 160 or edge((x, y)) or \
                    sum(dark((x + dx, y + dy)) for dx, dy in N4) < 3:
                continue
            comp, todo = set(), [(x + dx, y + dy) for dx, dy in N4]
            while todo:
                p = todo.pop()
                if p in comp or not dark(p) or abs(p[0] - x) > 1 or abs(p[1] - y) > 2:
                    continue
                comp.add(p)
                todo += [(p[0] + dx, p[1] + dy) for dx, dy in N4]
            if any(edge(p) for p in comp) or any(comp & e["px"] for e in eyes):
                continue
            pts = comp | {(x, y)}
            ring = {}
            for px_, py in pts:
                for dx in (-1, 0, 1):
                    for dy in (-1, 0, 1):
                        q = (px_ + dx, py + dy)
                        if q not in pts and at(*q) is not None and not dark(q):
                            ring[at(*q)] = ring.get(at(*q), 0) + 1
            if not ring:
                continue
            xs, ys = [p[0] for p in pts], [p[1] for p in pts]
            eyes.append({"px": pts, "hl": (x, y), "box": (min(xs), min(ys), max(xs), max(ys)),
                         "colors": {p: at(*p) for p in pts}, "dark": at(*next(iter(comp))),
                         "fill": max(ring, key=ring.get)})
    return eyes


def eye_shape(w, h, state):
    """Pixels of a closed eye in a w x h box: "closed" = a smile line, "happy" = ^."""
    if w < 3 or h < 2:
        return [(i, h - 1) for i in range(w)]
    lo, hi = (h - 1, h - 2) if state == "happy" else (h - 2, h - 1)
    return [(0, lo), (w - 1, lo)] + [(i, hi) for i in range(1, w - 1)]


def shrink(g, s, detail):
    """Pixel art scaled by s < 1: per target pixel the color covering most of it wins."""
    H, W = len(g), len(g[0])
    out = []
    for ty in range(max(1, round(H * s))):
        y0, y1 = ty / s, min(H, (ty + 1) / s)
        row = []
        for tx in range(max(1, round(W * s))):
            x0, x1 = tx / s, min(W, (tx + 1) / s)
            votes, tot = {}, 0.0
            for sy in range(int(y0), math.ceil(y1)):
                hy = min(y1, sy + 1) - max(y0, sy)
                for sx in range(int(x0), math.ceil(x1)):
                    a = hy * (min(x1, sx + 1) - max(x0, sx))
                    if a > 0:
                        votes[g[sy][sx]] = votes.get(g[sy][sx], 0) + a
                        tot += a
            best = None
            if votes.pop(None, 0) <= tot / 2 and votes:
                rare = [c for c in votes if c in detail and votes[c] >= tot / 4]
                best = max(rare or votes, key=lambda c: votes[c] * (1.25 if lum(c) < 48 else 1))
            row.append(best)
        out.append(row)
    return out


class Dancer:
    def __init__(self, frames):
        self.frames = []        # (grid without eyes, eyes, detail colors)
        for g in frames:
            eyes = find_eyes(g)
            g = [row[:] for row in g]
            for e in eyes:
                for x, y in e["px"]:
                    g[y][x] = e["fill"]
            count = {}
            for row in g:
                for c in row:
                    count[c] = count.get(c, 0) + 1
            detail = {c for c, n in count.items() if c is not None and n <= 6 and lum(c) >= 48}
            self.frames.append((g, eyes, detail))
        self.H, self.W = len(frames[0]), len(frames[0][0])
        n = len(frames)
        self.seq = list(range(n)) + list(range(n - 2, 0, -1))  # ping-pong, like fury plays it
        self.cache = {}
        self.fits = {}

    def dims(self, s):
        return max(1, round(self.W * s)), max(1, round(self.H * s))

    def hop(self, gh):
        return max(1, round(gh / 12))

    def fit(self, cols, max_rows):
        """(scale, rows) of the largest sprite that fits cols x max_rows cells, or None."""
        key = (cols, max_rows)
        if key not in self.fits:
            self.fits[key] = None
            for s in DANCER_SCALES:
                gw, gh = self.dims(s)
                need = gh + math.ceil(self.hop(gh) * DANCER_JUMP) + 1  # + jump + shadow
                rows = (need + 1) // 2
                if gw + 2 <= cols and rows <= max_rows:
                    self.fits[key] = (s, min(max_rows, rows + 1))  # + a row for hearts
                    break
        return self.fits[key]

    def sprites(self, s):
        """{(frame, eye state): grid} at scale s, plus the size, foot row and head."""
        if s in self.cache:
            return self.cache[s]
        out = {}
        for fi, (g, eyes, detail) in enumerate(self.frames):
            if s >= 1:
                base = [[c for c in row for _ in range(s)] for row in g for _ in range(s)]
            else:
                base = shrink(g, s, detail)
            for state in ("open", "closed", "happy"):
                grid = [row[:] for row in base]
                for e in eyes:
                    self.stamp(grid, e, s, state)
                out[fi, state] = grid
        gw, gh = self.dims(s)
        grids = [out[fi, "open"] for fi in range(len(self.frames))]
        foot = max(y for g in grids for y in range(gh) if any(g[y]))
        top = min(y for y in range(gh) if any(grids[0][y]))
        band = [x for y in range(top, top + max(1, gh // 8)) for x in range(gw) if grids[0][y][x]]
        head = (round(sum(band) / len(band)), top)
        self.cache[s] = (out, (gw, gh), foot, head)
        return self.cache[s]

    def stamp(self, grid, e, s, state):
        def put_px(x, y, c):
            if 0 <= y < len(grid) and 0 <= x < len(grid[0]):
                grid[y][x] = c

        x0, y0, x1, y1 = e["box"]
        w, h = x1 - x0 + 1, y1 - y0 + 1
        if s >= 1:
            if state == "open":
                pts = [((x - x0, y - y0), c) for (x, y), c in e["colors"].items()]
            else:
                pts = [(p, e["dark"]) for p in eye_shape(w, h, state)]
            for (x, y), c in pts:
                for i in range(s):
                    for j in range(s):
                        put_px((x0 + x) * s + i, (y0 + y) * s + j, c)
            return
        tw, th = max(2, round(w * s)), max(2, round(h * s))
        tx = round((x0 + x1 + 1) / 2 * s - tw / 2)
        ty = round((y0 + y1 + 1) / 2 * s - th / 2)
        if state == "open":
            for i in range(tw):
                for j in range(th):
                    put_px(tx + i, ty + j, e["dark"])
            hx, hy = e["hl"]
            put_px(tx + min(tw - 1, int((hx - x0) / w * tw)), ty + min(th - 1, int((hy - y0) / h * th)),
                   e["colors"][e["hl"]])
        else:
            for x, y in eye_shape(tw, th, state):
                put_px(tx + x, ty + y, e["dark"])

    def pose(self, beat, amp):
        """Offset from the center and facing (True = left, as drawn) at a beat."""
        p = beat % 16
        if p < 8:                                   # walk to and fro
            ph = 2 * math.pi * p / 8
            return amp * math.sin(ph), (math.cos(ph) < 0) if amp else int(p) // 2 % 2 == 0
        if p < 12:                                  # wiggle: turn on every beat
            return 0, int(p) % 2 == 0
        if p < 15:                                  # twirl: turn in the air
            return 0, int(p * 2) % 2 == 0
        return 0, True                              # the big jump

    def render(self, cols, rows, s, beat, awake, now, C):
        """Rows of (upper, lower) pixel colors for a cols x rows cell area."""
        out, (gw, gh), foot, (hx, htop) = self.sprites(s)
        cw, ch = cols, rows * 2
        cv = [[None] * cw for _ in range(ch)]

        def put_px(x, y, c):
            if 0 <= x < cw and 0 <= y < ch:
                cv[y][x] = c

        def bitmap(name, x, y, c):
            for j, line in enumerate(BITMAPS[name][s >= 1]):
                for i, b in enumerate(line):
                    if b == "#":
                        put_px(x + i, y + j, c)

        hop = self.hop(gh)
        amp = max(0, (cw - gw) // 2 - 1)
        beat = max(0.0, beat)
        p = beat % 16
        dx, left = self.pose(beat, amp)
        if awake:
            lift = abs(math.sin(math.pi * beat)) * hop * (DANCER_JUMP if p >= 15 else 1)
            eyes = "happy" if p >= 15 else ("closed" if now % 3.7 < 0.16 else "open")
            grid = out[self.seq[int(beat * 3) % len(self.seq)], eyes]
        else:
            lift, grid = 0, out[0, "closed"]
        gx = (cw - gw) // 2 + round(dx)
        g0 = ch - 2 - foot              # top row of the sprite while standing
        gy = g0 - round(lift)
        # shadow on the ground, smaller while in the air
        sw_ = max(2, round(gw * 0.5) - 2 * round(lift))
        for x in range(gx + (gw - sw_) // 2, gx + (gw - sw_) // 2 + sw_):
            put_px(x, ch - 1, C["overlay"])
        head_x = gx + (hx if left else gw - 1 - hx)
        # particles first: the dancer passes in front of them
        if awake:
            # one heart or note per beat, four hearts on the big jump; positions come from
            # the beat number, so they stay put across pauses and seeks
            rise = max(2.0, gh / 9)
            for k in range(max(0, math.floor(beat) - DANCER_LIFE + 1), math.floor(beat) + 1):
                age = beat - k
                kgx = (cw - gw) // 2 + round(self.pose(k, amp)[0])
                burst = k % 16 == 15
                for i in range(4 if burst else 1):
                    r = prand(k, i)
                    if burst:
                        kind, col = "heart", (C["accent_text"], C["purple_hi"])[(i + i // 2) % 2]
                        side, tier = (-1 if i % 2 == 0 else 1), i // 2
                        x = kgx + gw // 2 + side * round(gw * 0.45 + tier * 3) - 2
                        y = g0 + htop + 6 - tier * 6 - round(age * rise * 1.3)
                    else:
                        kind = "heart" if k % 2 == 0 else ("notes" if r < 0.4 else "note")
                        col = ((C["accent_text"], C["purple_hi"]) if kind == "heart" else
                               (C["yellow_hi"], C["aqua_hi"], C["blue_hi"]))[int(r * 97) % (2 if kind == "heart" else 3)]
                        side = -1 if prand(k, 7) < 0.5 else 1
                        x = kgx + gw // 2 + side * round(gw * 0.42 + r * 3) - 2
                        y = g0 + round(gh * 0.3) + round(r * 4) - round(age * rise)
                        x += round(math.sin(age * 2.6 + k) * 1.2)
                    if age < 0.14:
                        kind, col = "spark", C["bright"]   # pops in with a sparkle
                    fade = max(0.0, (age - DANCER_LIFE * 0.55) / (DANCER_LIFE * 0.45))
                    bitmap(kind, x, y, blend(col, C["bg"], min(1.0, fade)))
        else:
            # asleep: z, then Z, drifting up away from the beak
            period = 1.2
            back = 1 if left else -1
            for k in range(math.floor(now / period) - 2, math.floor(now / period) + 1):
                age = now - k * period
                name = "z" if age < period else "Z"
                x = head_x + back * (3 + round(age * 2.2)) - (0 if back > 0 else 4)
                y = g0 + htop - 4 - round(age * 3)
                fade = max(0.0, (age - 2.0) / 1.6)
                bitmap(name, x, y, blend(C["blue_hi"], C["bg"], min(1.0, fade)))
        for y, row in enumerate(grid):
            for x, c in enumerate(row if left else reversed(row)):
                if c is not None:
                    put_px(gx + x, gy + y, c)
        return [tuple(zip(cv[y], cv[y + 1])) for y in range(0, ch, 2)]


def sgr_color(c, base, tc):
    if c is None:
        return str(base + 9)
    if tc:
        return f"{base + 8};2;{c[0]};{c[1]};{c[2]}"
    return f"{base + 8};5;{xterm256(c)}"


def cell_row(row, tc):
    """A row of (upper, lower) colors as half blocks; None = the terminal background."""
    parts, cur = ["\x1b[0m"], (None, None)
    for t, b in row:
        if t == b:
            want, ch = (cur[0], t), " "
        elif t is None:
            want, ch = (b, None), "\u2584"
        elif b is None:
            want, ch = (t, None), "\u2580"
        else:
            want, ch = (t, b), "\u2580"
        if want != cur:
            codes = [sgr_color(want[i], base, tc) for i, base in ((0, 30), (1, 40)) if want[i] != cur[i]]
            parts.append(f"\x1b[{';'.join(codes)}m")
            cur = want
        parts.append(ch)
    return "".join(parts) + "\x1b[0m"


# ---------------------------------------------------------------- mpv IPC
class MPV:
    def __init__(self, path):
        self.path = path
        self.sock = None
        self.props = {}
        self.events = []
        self.alive = True
        self.tpos_at = 0.0      # monotonic time of the last time-pos update (dancer clock)

    def connect(self, proc, timeout=10):
        deadline = time.time() + timeout
        while time.time() < deadline:
            if proc.poll() is not None:
                return False
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                s.connect(self.path)
                self.sock = s
                break
            except OSError:
                s.close()
                time.sleep(0.05)
        else:
            return False
        threading.Thread(target=self._reader, daemon=True).start()
        for i, name in enumerate(OBSERVE, 1):
            self.send("observe_property", i, name)
        return True

    def send(self, *cmd):
        if not self.sock:
            return
        try:
            self.sock.sendall((json.dumps({"command": list(cmd)}) + "\n").encode())
        except OSError:
            self.alive = False

    def _reader(self):
        buf = b""
        while True:
            try:
                chunk = self.sock.recv(65536)
            except OSError:
                break
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                try:
                    self._handle(json.loads(line))
                except ValueError:
                    continue
        self.alive = False

    def _handle(self, m):
        ev = m.get("event")
        if ev == "property-change":
            self.props[m.get("name")] = m.get("data")
            if m.get("name") == "time-pos":
                self.tpos_at = time.monotonic()
        elif ev == "file-loaded":
            self.events.append(("loaded", None))
        elif ev == "end-file" and m.get("reason") == "error":
            self.events.append(("error", m.get("file_error") or "playback error"))

    def get(self, name, default=None):
        v = self.props.get(name)
        return default if v is None else v


# ---------------------------------------------------------------- App
SPECIAL = {curses.KEY_UP: "UP", curses.KEY_DOWN: "DOWN", curses.KEY_LEFT: "LEFT",
           curses.KEY_RIGHT: "RIGHT", curses.KEY_HOME: "HOME", curses.KEY_END: "END",
           curses.KEY_PPAGE: "PGUP", curses.KEY_NPAGE: "PGDN", curses.KEY_BACKSPACE: "BS",
           curses.KEY_ENTER: "ENTER", curses.KEY_F1: "F1", curses.KEY_DC: "DEL"}
CHARS = {"\n": "ENTER", "\r": "ENTER", "\x1b": "ESC", "\x7f": "BS", "\b": "BS"}


class App:
    def __init__(self, scr, mpv):
        self.scr, self.mpv = scr, mpv
        self.A = make_attrs()
        self.mode = "NORMAL"
        self.buf = ""
        self.cur = self.top = 0
        self.count = self.pend = ""
        self.search, self.sdir, self.hl = "", 1, False
        self.saved_cur = 0
        self.log, self.hist, self.hist_i = [], [], None
        self.flash = ("", 0)
        self.help, self.help_top = False, 0
        self.running = True
        self.names = {}
        self.last_play = -2
        self.page_h = 10
        self.covers = Covers()
        self.cover_on = os.environ.get("MPVIM_COVER", "1") != "0"
        self.cover_shown = None     # rows currently on screen (kept while the next one loads)
        self.cover_painted = None   # (rect, rows) last painted
        self.cover_time = 0.0
        self.cover_rect = None
        self.dancer = None          # Dancer, loaded on the first :dancer
        self.dancer_on = False
        self.dancer_cells = None    # rows last painted (only changed rows are rewritten)
        self.dancer_colors = None
        self.say("Type :help or press F1 for key bindings.")
        self.say("Enter plays, Space pauses, h/l seeks, / searches, i filters, q quits.")

    # ----- Zustand
    def say(self, text, err=False):
        self.log.append((time.strftime("%H:%M:%S"), text, err))
        del self.log[:-300]
        if err:
            self.flash = (text, time.time() + 4)

    def pl(self):
        return self.mpv.props.get("playlist") or []

    def name(self, i):
        fn = self.pl()[i].get("filename", "")
        n = self.names.get(fn)
        if n is None:
            n = self.names[fn] = disp(fn)
        return n

    def playing(self):
        for i, e in enumerate(self.pl()):
            if e.get("current"):
                return i
        return -1

    def vis(self):
        n = len(self.pl())
        if self.mode == "INSERT" and self.buf.strip():
            return [i for i in range(n) if match(self.name(i), self.buf)]
        return list(range(n))

    def real_cur(self):
        v = self.vis()
        return v[self.cur] if 0 <= self.cur < len(v) else None

    def move(self, d):
        self.cur = max(0, min(self.cur + d, len(self.vis()) - 1))

    def goto(self, i):
        self.cur = max(0, min(i, len(self.vis()) - 1))

    def take_count(self):
        n = int(self.count) if self.count else None
        self.count = ""
        return n

    def tick(self):
        p = self.playing()
        if p != self.last_play:
            if self.mode == "NORMAL" and p >= 0 and (self.cur == self.last_play or self.last_play < 0):
                self.cur = p
            self.last_play = p
        while self.mpv.events:
            kind, data = self.mpv.events.pop(0)
            if kind == "loaded":
                md = {str(k).lower(): v for k, v in (self.mpv.get("metadata") or {}).items()}
                title = md.get("title") or self.mpv.get("media-title") or "?"
                artist = md.get("artist")
                self.say("\u25b6 " + (f"{artist} \u2013 {title}" if artist else str(title)))
            else:
                self.say(f"Error: {data}", True)

    # ----- Aktionen
    def play(self):
        i = self.real_cur()
        if i is None:
            return
        self.mpv.send("playlist-play-index", i)
        self.mpv.send("set_property", "pause", False)

    def remove(self):
        i = self.real_cur()
        if i is None:
            return
        self.say("removed: " + self.name(i))
        self.mpv.send("playlist-remove", i)

    def move_item(self, d):
        n, i = len(self.pl()), self.cur
        if d > 0 and i < n - 1:
            self.mpv.send("playlist-move", i, i + 2)
            self.cur += 1
        elif d < 0 and i > 0:
            self.mpv.send("playlist-move", i, i - 1)
            self.cur -= 1

    def set_repeat(self, mode):
        self.mpv.send("set_property", "loop-file", "inf" if mode == "file" else "no")
        self.mpv.send("set_property", "loop-playlist", "inf" if mode == "playlist" else "no")
        self.say(f"repeat: {mode}")

    def repeat_state(self):
        if on(self.mpv.props.get("loop-file")):
            return "file"
        if on(self.mpv.props.get("loop-playlist")):
            return "playlist"
        return "off"

    def find(self, q, start, d, inclusive=False):
        v = self.vis()
        n = len(v)
        for step in (range(0, n) if inclusive else range(1, n + 1)):
            j = (start + d * step) % n
            if match(self.name(v[j]), q):
                return j
        return None

    def jump_match(self, direction):
        if not self.search:
            self.say("No previous search pattern", True)
            return
        self.hl = True
        j = self.find(self.search, self.cur, direction * self.sdir)
        if j is None:
            self.say(f"Pattern not found: {self.search}", True)
        else:
            self.cur = j

    def seek_cmd(self, arg):
        m = re.fullmatch(r"([+-]?)(\d+(?::\d+){0,2}(?:\.\d+)?)(%?)", arg.strip())
        if not m:
            self.say("usage: :seek 1:30 | +10 | -10 | 50%", True)
            return
        sign, ts, pct = m.groups()
        secs = sum(float(p) * 60 ** i for i, p in enumerate(reversed(ts.split(":"))))
        if pct:
            self.mpv.send("seek", secs, "absolute-percent")
        elif sign:
            self.mpv.send("seek", secs if sign == "+" else -secs, "relative")
        else:
            self.mpv.send("seek", secs, "absolute")

    def toggle_dancer(self):
        if self.dancer_on:
            self.dancer_on = False
            self.say("dancer off")
            return
        if self.dancer is None:
            try:
                self.dancer = Dancer(load_sheet(dancer_path()))
            except DancerError as e:
                self.say(str(e), True)
                return
            self.dancer_colors = theme_colors()
        self.dancer_on = True
        H, W = self.scr.getmaxyx()
        if self.dancer.fit(W - int(W * 0.72) - 2, H - 3 - 13) is None:
            self.say("dancer on (needs a larger terminal to show up)", True)
        else:
            self.say("dancer on")

    def bpm(self):
        """(beats per minute, from a tag?) of the playing track."""
        md = self.meta()
        for key in ("bpm", "tbpm", "tempo"):
            m = re.match(r"\s*(\d{1,3}(?:[.,]\d+)?)", str(md.get(key, "")))
            if m and float(m.group(1).replace(",", ".")) >= 10:
                v = float(m.group(1).replace(",", "."))
                while v < 70:
                    v *= 2
                while v > 180:
                    v /= 2
                return v, True
        return float(DANCER_BPM), False

    def media_time(self):
        """Track position now: mpv reports it a few times a second, the rest is extrapolated."""
        P = self.mpv.props.get
        tp = P("time-pos")
        if not isinstance(tp, (int, float)):
            return 0.0
        if P("pause") or P("idle-active"):
            return tp
        sp = P("speed") if isinstance(P("speed"), (int, float)) else 1.0
        return tp + min(1.0, max(0.0, time.monotonic() - self.mpv.tpos_at)) * sp

    def awake(self):
        P = self.mpv.props.get
        return bool(P("path")) and not P("pause") and not P("idle-active")

    def command(self, line):
        line = line.strip()
        if not line:
            return
        self.hist.append(line)
        if line.isdigit():
            self.goto(int(line) - 1)
            return
        cmd, _, arg = line.partition(" ")
        arg = arg.strip()
        send = self.mpv.send
        if cmd in ("q", "quit", "qa", "q!", "wq", "x"):
            self.running = False
        elif cmd in ("vol", "volume"):
            if re.fullmatch(r"[+-]\d+", arg):
                send("add", "volume", int(arg))
            elif arg.isdigit():
                send("set_property", "volume", int(arg))
            else:
                self.say("usage: :vol 50 | +10 | -10", True)
        elif cmd == "seek":
            self.seek_cmd(arg)
        elif cmd == "play":
            if arg.isdigit():
                self.goto(int(arg) - 1)
            self.play()
        elif cmd == "pause":
            send("cycle", "pause")
        elif cmd == "next":
            send("playlist-next")
        elif cmd in ("prev", "previous"):
            send("playlist-prev")
        elif cmd == "mute":
            send("cycle", "mute")
        elif cmd == "shuffle":
            send("playlist-shuffle")
            self.say("shuffled")
        elif cmd == "unshuffle":
            send("playlist-unshuffle")
            self.say("unshuffled")
        elif cmd == "loop":
            mode = {"off": "off", "no": "off", "none": "off", "playlist": "playlist",
                    "all": "playlist", "file": "file", "track": "file", "one": "file"}.get(arg)
            if mode:
                self.set_repeat(mode)
            else:
                self.say("usage: :loop off|playlist|file", True)
        elif cmd == "speed":
            try:
                send("set_property", "speed", float(arg))
            except ValueError:
                self.say("usage: :speed 1.25", True)
        elif cmd == "add":
            try:
                files = collect(shlex.split(arg))
            except ValueError:
                files = []
            for f in files:
                send("loadfile", f, "append-play")
            self.say(f"added {len(files)} file(s)" if files else "nothing to add", not files)
        elif cmd == "noh":
            self.hl = False
        elif cmd == "clear":
            self.log.clear()
        elif cmd == "cover":
            self.cover_on = not self.cover_on
            self.say("cover " + ("on" if self.cover_on else "off"))
        elif cmd == "dancer":
            self.toggle_dancer()
        elif cmd in ("help", "h"):
            self.help = True
        else:
            self.say(f"Not an editor command: {line}", True)

    # ----- Eingabe
    def on_key(self, k):
        if isinstance(k, int):
            k = SPECIAL.get(k)
            if k is None:
                return
        else:
            k = CHARS.get(k, k)
        if self.help:
            if k in ("j", "DOWN"):
                self.help_top += 1
            elif k in ("k", "UP"):
                self.help_top -= 1
            elif k in ("\x04", "PGDN", " "):
                self.help_top += 10
            elif k in ("\x15", "PGUP"):
                self.help_top -= 10
            elif k == "\x03":
                self.running = False
            elif k in ("q", "ESC", "F1", "ENTER", "?"):
                self.help = False
            return
        if self.mode == "NORMAL":
            self.normal(k)
        else:
            self.text_mode(k)

    def enter_mode(self, mode):
        self.mode, self.buf, self.hist_i = mode, "", None
        self.saved_cur = self.cur

    def normal(self, k):
        k = {"UP": "k", "DOWN": "j", "LEFT": "h", "RIGHT": "l",
             "PGUP": "\x02", "PGDN": "\x06"}.get(k, k)
        if k == "HOME":
            self.pend = ""
            self.count = ""
            self.goto(0)
            return
        if k == "END":
            self.goto(len(self.vis()) - 1)
            return
        if k == "F1":
            self.help = True
            return
        if k == "ESC":
            self.count = self.pend = ""
            return
        if k == "\x03":
            self.running = False
            return
        if self.pend:
            seq, self.pend = self.pend + k, ""
            n = self.take_count()
            if seq == "gg":
                self.goto(n - 1 if n else 0)
            elif seq == "gc":
                if self.playing() >= 0:
                    self.goto(self.playing())
            elif seq == "dd":
                self.remove()
            elif seq in ("ZZ", "ZQ"):
                self.running = False
            return
        if k in ("g", "d", "Z"):
            self.pend = k
            return
        if len(k) == 1 and k.isdigit() and (k != "0" or self.count):
            self.count += k
            return
        n = self.take_count()
        c = n or 1
        send = self.mpv.send
        if k == "j":
            self.move(c)
        elif k == "k":
            self.move(-c)
        elif k == "G":
            self.goto(n - 1 if n else len(self.vis()) - 1)
        elif k == "\x04":
            self.move(max(1, self.page_h // 2))
        elif k == "\x15":
            self.move(-max(1, self.page_h // 2))
        elif k == "\x06":
            self.move(self.page_h)
        elif k == "\x02":
            self.move(-self.page_h)
        elif k == "ENTER":
            self.play()
        elif k in (" ", "p"):
            if self.mpv.props.get("idle-active"):
                self.play()
            else:
                send("cycle", "pause")
        elif k == "h":
            send("seek", -5 * c)
        elif k == "l":
            send("seek", 5 * c)
        elif k == "H":
            send("seek", -30 * c)
        elif k == "L":
            send("seek", 30 * c)
        elif k == "0":
            send("seek", 0, "absolute")
        elif k == "%":
            if n is not None:
                send("seek", min(n, 100), "absolute-percent")
        elif k in (">", "\x0e"):
            for _ in range(c):
                send("playlist-next")
        elif k in ("<", "\x10"):
            for _ in range(c):
                send("playlist-prev")
        elif k in ("+", "="):
            send("add", "volume", 5 * c)
        elif k == "-":
            send("add", "volume", -5 * c)
        elif k == "m":
            send("cycle", "mute")
        elif k == "{":
            send("add", "speed", -0.1 * c)
        elif k == "}":
            send("add", "speed", 0.1 * c)
        elif k == "s":
            send("playlist-shuffle")
            self.say("shuffled")
        elif k == "S":
            send("playlist-unshuffle")
            self.say("unshuffled")
        elif k == "r":
            nxt = {"off": "playlist", "playlist": "file", "file": "off"}[self.repeat_state()]
            self.set_repeat(nxt)
        elif k == "J":
            self.move_item(1)
        elif k == "K":
            self.move_item(-1)
        elif k == "i":
            self.enter_mode("INSERT")
        elif k == ":":
            self.enter_mode("COMMAND")
        elif k in ("/", "?"):
            self.sdir = 1 if k == "/" else -1
            self.enter_mode("SEARCH")
        elif k == "n":
            self.jump_match(1)
        elif k == "N":
            self.jump_match(-1)
        elif k == "q":
            self.running = False
        elif k == "\x0c":
            self.scr.clearok(True)
            self.cover_painted = None  # repaint the raw cover / dancer cells too

    def edit(self, k):
        if k == "BS":
            self.buf = self.buf[:-1]
        elif k == "\x17":
            self.buf = re.sub(r"\S*\s*$", "", self.buf)
        elif k == "\x15":
            self.buf = ""
        elif len(k) == 1 and k.isprintable():
            self.buf += k
        else:
            return False
        return True

    def leave_insert(self, play):
        real = self.real_cur()
        self.mode, self.buf = "NORMAL", ""
        if real is not None:
            self.cur = real
            if play:
                self.play()

    def hist_step(self, d):
        if not self.hist:
            return
        i = len(self.hist) if self.hist_i is None else self.hist_i
        i = max(0, min(len(self.hist), i + d))
        self.hist_i = None if i == len(self.hist) else i
        self.buf = "" if self.hist_i is None else self.hist[self.hist_i]

    def text_mode(self, k):
        m = self.mode
        if k in ("ESC", "\x03") or (k == "BS" and not self.buf and m != "INSERT"):
            if m == "SEARCH":
                self.cur = self.saved_cur
            if m == "INSERT":
                self.leave_insert(False)
            else:
                self.mode, self.buf = "NORMAL", ""
            return
        if k == "ENTER":
            if m == "INSERT":
                self.leave_insert(True)
            elif m == "COMMAND":
                line, self.mode, self.buf = self.buf, "NORMAL", ""
                self.command(line)
            else:
                if self.buf:
                    self.search, self.hl = self.buf, True
                else:
                    self.cur = self.saved_cur
                self.mode, self.buf = "NORMAL", ""
            return
        if k in ("UP", "DOWN", "\x10", "\x0e"):
            d = -1 if k in ("UP", "\x10") else 1
            if m == "INSERT":
                self.move(d)
            elif m == "COMMAND":
                self.hist_step(d)
            return
        if self.edit(k):
            if m == "INSERT":
                self.cur = 0
            elif m == "SEARCH":
                j = self.find(self.buf, self.saved_cur, self.sdir, True) if self.buf else None
                self.cur = self.saved_cur if j is None else j

    # ----- Zeichnen
    def draw(self):
        s, A = self.scr, self.A
        s.erase()
        H, W = s.getmaxyx()
        if H < 14 or W < 60:
            put(s, 0, 0, "Terminal too small (min 60x14)", A["red"])
            s.refresh()
            return
        lw = int(W * 0.72)
        rw = W - lw
        mh = H - 3
        # Right column: [cover | dancer] now playing, properties, log. The cover is square (a
        # cell is about twice as high as wide) and only shown if the boxes below keep their
        # room. The dancer may take the room of properties and log (now playing stays).
        fit = cover = None
        if self.dancer_on and self.dancer:
            fit = self.dancer.fit(rw - 2, mh - 13)
        else:
            cover = self.cover_rows(rw, mh)
        ch = 0
        if fit:
            ch = fit[1] + 2
            r = mh - ch - 11
            if r < 3:
                ch, r = ch + r, 0    # too little for another box: the dancer gets it
            h1, h2 = 11, (r // 2 if r >= 10 else 0)
        else:
            if cover:
                cols = rw - 4
                ch = min(cols // 2, mh - 24) + 2
            rest = mh - ch
            if ch:
                h1 = min(11, rest // 2)
                h2 = (rest - h1) // 2
            else:
                h1 = h2 = rest // 3
        h3 = mh - ch - h1 - h2
        if self.help:
            self.draw_help(0, 0, mh, lw)
        else:
            self.draw_playlist(0, 0, mh, lw)
        target = None
        if fit:
            title = [("\U000F01E5 dancer", A["title"])]
            bpm, tagged = self.bpm()
            if not self.awake():
                title.append(("  asleep", A["dim"]))
            elif tagged:
                title.append((f"  {bpm:.0f} bpm", A["dim"]))
            draw_box(s, 0, lw, ch, rw, title, A["border"])
            target = ("dancer", (1, lw + 1, ch - 2, rw - 2), fit[0])
        elif ch:
            draw_box(s, 0, lw, ch, rw, [("\U000F0025 cover", A["title"])], A["border"])
            self.cover_rect = (1, lw + 2, ch - 2, rw - 4)
            target = ("cover", self.cover_rect, cover)
        self.draw_now(ch, lw, h1, rw)
        if h2:
            self.draw_props(ch + h1, lw, h2, rw)
        if h3:
            self.draw_log(ch + h1 + h2, lw, h3, rw)
        self.draw_input(mh, 0, 3, W)
        if target != self.cover_painted:
            if self.cover_painted is not None:
                s.clearok(True)  # wipe the old pixels (curses believes those cells are blank)
            self.dancer_cells = None
        s.refresh()
        if fit:
            self.paint_dancer(target[1], target[2])
        elif target and (target != self.cover_painted or time.time() - self.cover_time > 5):
            self.paint_cover(target[1], target[2])
        self.cover_painted = target

    def cover_rows(self, rw, mh):
        """Rendered cover for the playing track if it fits; keeps the previous one while loading."""
        path = self.mpv.props.get("path")
        cols = rw - 4
        rows = min(cols // 2, mh - 24)
        if not self.cover_on or not path or rows < 6:
            self.cover_shown = None
            return None
        res = self.covers.get((path, cols, rows))
        if res is not False:
            self.cover_shown = res
        return self.cover_shown

    def paint_cover(self, rect, rows):
        y0, x0, h, w = rect
        top = y0 + max(0, (h - len(rows)) // 2)
        out = []
        for i, (line, width) in enumerate(rows[:h]):
            left = x0 + max(0, (w - width) // 2)
            out.append(f"\x1b[{top + i + 1};{left + 1}H{line}\x1b[0m")
        cy, cx = self.scr.getyx()
        out.append(f"\x1b[{cy + 1};{cx + 1}H")  # back to where curses thinks the cursor is
        sys.stdout.write("".join(out))
        sys.stdout.flush()
        self.cover_time = time.time()

    def paint_dancer(self, rect, scale):
        y0, x0, h, w = rect
        bpm = self.bpm()[0]
        rows = self.dancer.render(w, h, scale, self.media_time() * bpm / 60, self.awake(),
                                  time.monotonic(), self.dancer_colors)
        if time.time() - self.cover_time > 5:
            self.dancer_cells = None  # now and then everything, in case the terminal lost it
        prev = self.dancer_cells
        out = [f"\x1b[{y0 + i + 1};{x0 + 1}H" + cell_row(row, self.covers.tc)
               for i, row in enumerate(rows) if prev is None or prev[i] != row]
        self.dancer_cells = rows
        if prev is None:
            self.cover_time = time.time()
        if not out:
            return
        cy, cx = self.scr.getyx()
        # synchronized update (DEC mode 2026): the terminal shows the frame at once
        sys.stdout.write("\x1b[?2026h" + "".join(out) + f"\x1b[{cy + 1};{cx + 1}H\x1b[?2026l")
        sys.stdout.flush()

    def draw_playlist(self, y, x, h, w):
        s, A = self.scr, self.A
        pl, v = self.pl(), self.vis()
        n = len(v)
        self.cur = max(0, min(self.cur, n - 1))
        title = [("\U000F0CB8 playlist", A["head"])]
        if self.mode == "INSERT" and self.buf.strip():
            title.append((f"  filter {n}/{len(pl)}", A["dim"]))
        draw_box(s, y, x, h, w, title, A["border"])
        ih = h - 2
        self.page_h = ih
        so = min(3, (ih - 1) // 2)
        if self.cur < self.top + so:
            self.top = max(0, self.cur - so)
        elif self.cur > self.top + ih - 1 - so:
            self.top = self.cur - ih + 1 + so
        self.top = max(0, min(self.top, max(0, n - ih)))
        if not pl:
            put(s, y + 1, x + 2, "(empty)", A["dim"])
        playing = self.playing()
        paused = self.mpv.props.get("pause")
        numw = len(str(len(pl)))
        q = self.buf if self.mode in ("INSERT", "SEARCH") else (self.search if self.hl else "")
        words = q.lower().split()
        for r in range(min(ih, n - self.top)):
            vi = self.top + r
            i = v[vi]
            sel, isp = vi == self.cur, i == playing
            attr = (A["selplay"] if isp else A["sel"]) if sel else (A["play"] if isp else A["text"])
            yy = y + 1 + r
            if sel:
                put(s, yy, x + 1, " " * (w - 2), attr)
            # md-pause / md-play glyphs; the red bar marks the cursor row (like rofi)
            mark = ("\U000F03E4" if paused else "\U000F040A") if isp else " "
            prefix = f"  {mark} {i + 1:>{numw}}  "
            put(s, yy, x + 1, prefix, attr if (isp or sel) else A["dim"])
            if sel:
                put(s, yy, x + 1, "\u258c", A["selbar"])
            nm = self.name(i)
            avail = w - 2 - sw(prefix) - 1
            px = x + 1 + sw(prefix)
            put(s, yy, px, trunc(nm, avail), attr)
            nl = nm.lower()
            for wd in words:
                idx = nl.find(wd)
                if idx >= 0 and sw(nm[:idx + len(wd)]) <= avail:
                    put(s, yy, px + sw(nm[:idx]), nm[idx:idx + len(wd)], A["hit"])
        ruler = f" {self.cur + 1 if n else 0}/{n} "
        put(s, y + h - 1, x + w - 2 - len(ruler), ruler, A["border"])

    def draw_help(self, y, x, h, w):
        s, A = self.scr, self.A
        draw_box(s, y, x, h, w, [("\U000F030C help", A["head"]), ("  j/k scroll, q/Esc close", A["dim"])], A["border"])
        ih = h - 2
        self.help_top = max(0, min(self.help_top, max(0, len(HELP) - ih)))
        for r, item in enumerate(HELP[self.help_top:self.help_top + ih]):
            yy = y + 1 + r
            if isinstance(item, str):
                put(s, yy, x + 2, item, A["head"])
            else:
                put(s, yy, x + 3, item[0], A["teal"])
                put(s, yy, x + 26, trunc(item[1], w - 28), A["text"])

    def meta(self):
        return {str(k).lower(): v for k, v in (self.mpv.get("metadata") or {}).items()}

    def draw_now(self, y, x, h, w):
        s, A, P = self.scr, self.A, self.mpv.props.get
        draw_box(s, y, x, h, w, [("\U000F0387 now playing", A["title"])], A["border"])
        md = self.meta()
        pos, dur = P("time-pos"), P("duration")
        if not P("path"):
            state = "\u25a0 stopped"
        else:
            state = "\u2016 paused" if P("pause") else "\u25b6 playing"
        vol = P("volume")
        vols = f"{round(vol)}%" if vol is not None else "-"
        if P("mute"):
            vols += " (muted)"
        sp = P("speed")
        rows = [("title", md.get("title") or P("media-title") or "-"),
                ("artist", md.get("artist") or "-"),
                ("album", md.get("album") or "-"),
                ("state", state),
                ("time", f"{fmt_time(pos)} / {fmt_time(dur)}"),
                None,
                ("volume", vols),
                ("speed", f"{sp:.2f}x" if sp else "-"),
                ("repeat", self.repeat_state())]
        iw = w - 13
        for r, row in enumerate(rows[:h - 2]):
            yy = y + 1 + r
            if row is None:
                # progress line, same style as the dunst volume/brightness bar
                bw = max(1, w - 5)
                ratio = min(1.0, max(0.0, pos / dur)) if pos and dur else 0
                f = int(ratio * bw)
                put(s, yy, x + 2, "\u2501" * f, A["accent"])
                put(s, yy, x + 2 + f, "\u2500" * (bw - f), A["dim"])
            else:
                label, val = row
                vattr = A["bold"] if label == "title" else (A["accent"] if label == "state" else A["text"])
                put(s, yy, x + 2, f"{label:<8}", A["label"])
                put(s, yy, x + 11, trunc(clean(str(val)), iw), vattr)

    def draw_props(self, y, x, h, w):
        s, A, P = self.scr, self.A, self.mpv.props.get
        draw_box(s, y, x, h, w, [("\U000F02FD properties", A["title"])], A["border"])
        md = self.meta()
        ap = P("audio-params") or {}
        br = P("audio-bitrate")
        pi, n = self.playing(), len(self.pl())
        rows = [("position", f"{pi + 1} / {n}" if pi >= 0 else f"- / {n}"),
                ("codec", P("audio-codec-name") or "-"),
                ("format", P("file-format") or "-"),
                ("rate", f"{ap['samplerate']} Hz" if ap.get("samplerate") else "-"),
                ("channels", ap.get("hr-channels") or ap.get("channels") or "-"),
                ("bitrate", f"{br / 1000:.0f} kbps" if br else "-"),
                ("genre", md.get("genre") or "-"),
                ("date", md.get("date") or md.get("year") or "-"),
                ("track", md.get("track") or "-")]
        for r, (k, val) in enumerate(rows[:h - 2]):
            put(s, y + 1 + r, x + 2, f"{k:<9}", A["label"])
            put(s, y + 1 + r, x + 12, trunc(clean(str(val)), w - 14), A["text"])

    def draw_log(self, y, x, h, w):
        s, A = self.scr, self.A
        draw_box(s, y, x, h, w, [("\U000F0279 log", A["title"])], A["border"])
        ih = h - 2
        for r, (ts, text, err) in enumerate(self.log[-ih:] if ih > 0 else []):
            yy = y + 1 + r
            put(s, yy, x + 2, ts, A["dim"])
            put(s, yy, x + 12, trunc(clean(text), w - 14), A["red"] if err else A["text"])

    def draw_input(self, y, x, h, w):
        s, A = self.scr, self.A
        mc = {"NORMAL": "blue", "INSERT": "green", "COMMAND": "yellow", "SEARCH": "yellow"}[self.mode]
        segs = [("\U000F07B7 input", A["title"]), ("  ", 0), (self.mode.lower(), A[mc] | curses.A_BOLD)]
        draw_box(s, y, x, h, w, segs, A["active"])
        prompt = {"NORMAL": "\u276f", "INSERT": "\u276f", "COMMAND": ":",
                  "SEARCH": "/" if self.sdir > 0 else "?"}[self.mode]
        put(s, y + 1, x + 2, prompt, A["accent"] | curses.A_BOLD)
        if self.mode == "NORMAL":
            typed = self.count + self.pend
            put(s, y + 1, x + 4, typed, A["text"])
            cx = x + 4 + len(typed)
            msg, until = self.flash
            if msg and time.time() < until:
                m = trunc(clean(msg), w - 12 - len(typed))
                put(s, y + 1, x + w - 3 - sw(m), m, A["red"])
            put(s, y + 1, cx, " ", A["dimcursor"])
        else:
            shown = self.buf
            avail = w - 8
            while sw(shown) > avail:
                shown = shown[1:]
            put(s, y + 1, x + 4, shown, A["text"])
            put(s, y + 1, x + 4 + sw(shown), " ", A["cursor"])

    def run(self):
        s = self.scr
        curses.curs_set(0)
        curses.raw()
        s.keypad(True)
        # never shift line contents with insert/delete character: that would move the cover
        s.idcok(False)
        s.idlok(False)
        s.timeout(100)
        while self.running and self.mpv.alive:
            self.tick()
            self.draw()
            s.timeout(1000 // DANCER_FPS if self.dancer_on else 100)
            try:
                k = s.get_wch()
            except curses.error:
                continue
            self.on_key(k)


# ---------------------------------------------------------------- main
def usage():
    print(__doc__)
    sys.exit(0)


def main():
    locale.setlocale(locale.LC_ALL, "")
    args = sys.argv[1:]
    if any(a in ("-h", "--help") for a in args):
        usage()
    if shutil.which("mpv") is None:
        sys.exit("mpvim: mpv not found in PATH")
    opts = [a for a in args if a.startswith("--") and a != "--"]
    paths = [a for a in args if not a.startswith("--")]
    files = collect(paths or ["."])
    if not files:
        sys.exit("mpvim: no audio files found")

    # mpv's IPC socket accepts any command (including "run"), so it lives in a private
    # 0700 directory instead of a predictable path in /tmp.
    sock_dir = tempfile.mkdtemp(prefix="mpvim-", dir=os.environ.get("XDG_RUNTIME_DIR") or None)
    sock_path = os.path.join(sock_dir, "mpv.sock")
    cmd = (["mpv", "--idle=yes", "--no-video", "--audio-display=no", "--force-window=no",
            "--no-terminal", "--input-ipc-server=" + sock_path] + opts + ["--"] + files)
    proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL)
    mpv = MPV(sock_path)
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))
    signal.signal(signal.SIGHUP, lambda *a: sys.exit(0))
    # curses without scroll regions (they would move the album cover, see no_scroll_terminfo).
    # $TERMINFO only points there while initscr() reads it: programs started later keep
    # the original environment.
    terminfo = no_scroll_terminfo(sock_dir)
    saved = os.environ.get("TERMINFO")

    def restore_env():
        if saved is None:
            os.environ.pop("TERMINFO", None)
        else:
            os.environ["TERMINFO"] = saved

    def ui(scr):
        restore_env()
        App(scr, mpv).run()

    try:
        if not mpv.connect(proc):
            sys.exit("mpvim: could not connect to mpv")
        if terminfo:
            os.environ["TERMINFO"] = terminfo
        curses.wrapper(ui)
    except KeyboardInterrupt:
        pass
    finally:
        restore_env()
        mpv.send("quit")
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
        shutil.rmtree(sock_dir, ignore_errors=True)


if __name__ == "__main__":
    main()
