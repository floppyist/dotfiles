AUDIO_EXT = {".mp3", ".flac", ".ogg", ".oga", ".opus", ".m4a", ".m4b", ".aac", ".wav",
             ".wma", ".ape", ".alac", ".aiff", ".aif", ".mka", ".wv", ".mpc", ".mp2",
             ".tta", ".dsf", ".dff", ".webm"}

OBSERVE = ["pause", "time-pos", "duration", "volume", "mute", "speed", "loop-file",
           "loop-playlist", "playlist", "media-title", "metadata", "audio-codec-name",
           "audio-params", "audio-bitrate", "file-format", "idle-active", "path"]

