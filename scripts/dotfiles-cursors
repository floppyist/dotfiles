    "sb_v_double_arrow": (resize(90), "ns-resize v_double_arrow double_arrow size_ver size-ver "
                                      "2870a09082c103050810ffdffffe0204 00008160000006810000408080010102"),
    "fd_double_arrow": (resize(-45), "nesw-resize size_bdiag fcf1c3c7cd4491d801f1e1c78f100000"),
    "bd_double_arrow": (resize(45), "nwse-resize size_fdiag c7088f0f3e6c8088236ef8e1e3e70000"),
    "col-resize": (split(0), "split_h"),
    "row-resize": (split(90), "split_v"),
    "top_side": (side(0), "n-resize"),
    "right_side": (side(90), "e-resize"),
    "bottom_side": (side(180), "s-resize"),
    "left_side": (side(270), "w-resize"),
    "top_left_corner": (corner(0), "nw-resize"),
    "top_right_corner": (corner(90), "ne-resize"),
    "bottom_right_corner": (corner(180), "se-resize"),
    "bottom_left_corner": (corner(270), "sw-resize"),
    "sb_up_arrow": (scroll_arrow(0), "up-arrow"),
    "sb_right_arrow": (scroll_arrow(90), "right-arrow"),
    "sb_down_arrow": (scroll_arrow(180), "down-arrow"),
    "sb_left_arrow": (scroll_arrow(270), "left-arrow"),
    "X_cursor": (x_cursor, "x-cursor pirate"),
    "dotbox": (dotbox, "target draped_box icon dot_box_mask"),
    "pencil": (pencil, "draft"),
    "zoom-in": (zoom("+"), ""),
    "zoom-out": (zoom("-"), ""),
    "ul_angle": (angle(0), ""),
    "ur_angle": (angle(90), ""),
    "lr_angle": (angle(180), ""),
    "ll_angle": (angle(270), ""),
    "top_tee": (tee(0), ""),
    "right_tee": (tee(90), ""),
    "bottom_tee": (tee(180), ""),
    "left_tee": (tee(270), ""),
