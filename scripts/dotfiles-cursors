ANIMATED = {"wait": 90, "left_ptr_watch": 90}     # frame delay (ms)


def draw(name, size, col, frame=0):
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    ctx = cairo.Context(surf)
    ctx.set_antialias(cairo.ANTIALIAS_GRAY)
    pen = Pen(ctx, size, col)
    fn = CURSORS[name][0]
    hot = fn(pen, frame) if name in ANIMATED else fn(pen)
    surf.flush()
    return surf, hot


def pixels(surf):
    data = bytes(surf.get_data())
    if sys.byteorder == "big":       # cairo is native-endian, Xcursor little-endian
        import array
        a = array.array("I", data)
        a.byteswap()
        data = a.tobytes()
    return data


def xcursor(name, col, sizes):
    images = []
    for size in sizes:
        frames = range(SPIN_FRAMES) if name in ANIMATED else [0]
        for f in frames:
            surf, (xh, yh) = draw(name, size, col, f)
            images.append((size, size, size, xh, yh, ANIMATED.get(name, 0), pixels(surf)))
    out = [struct.pack("<4sIII", b"Xcur", 16, 0x10000, len(images))]
    pos = 16 + 12 * len(images)
    chunks = []
    for nominal, w, h, xh, yh, delay, data in images:
        out.append(struct.pack("<III", 0xFFFD0002, nominal, pos))
        chunk = struct.pack("<9I", 36, 0xFFFD0002, nominal, 1, w, h, xh, yh, delay) + data
        chunks.append(chunk)
        pos += len(chunk)
    return b"".join(out + chunks)


def stamp(col, sizes):
    h = hashlib.sha256(open(os.path.realpath(__file__), "rb").read())
    h.update(repr((sorted(col.items()), sizes)).encode())
    return h.hexdigest()


def build(target, col, sizes):
    target = os.path.abspath(target)
    marker = os.path.join(target, MARKER)
    want = stamp(col, sizes)
    try:
        if open(marker).read().strip() == want:
            return False
    except OSError:
        pass
    if os.path.lexists(target) and not os.path.isfile(marker):
        raise SystemExit("dotfiles-cursors: %s exists and was not made by dotfiles-cursors, not touching it" % target)
    tmp = target + ".new"
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(os.path.join(tmp, "cursors"))
    for name, (_, aliases) in CURSORS.items():
        with open(os.path.join(tmp, "cursors", name), "wb") as f:
            f.write(xcursor(name, col, sizes))
        for a in aliases.split():
            os.symlink(name, os.path.join(tmp, "cursors", a))
    theme = "[Icon Theme]\nName=%s\nComment=Generated by dotfiles-cursors from dotfiles.conf\nInherits=Adwaita\n" % THEME
    for fn in ("index.theme", "cursor.theme"):
        with open(os.path.join(tmp, fn), "w") as f:
            f.write(theme)
    with open(os.path.join(tmp, MARKER), "w") as f:
        f.write(want + "\n")
    old = target + ".old"
    shutil.rmtree(old, ignore_errors=True)
    if os.path.lexists(target):
        os.rename(target, old)
    os.rename(tmp, target)
    shutil.rmtree(old, ignore_errors=True)
    return True


def preview(path, col):
    """All cursors at 32 and 64 px on dark, mid and light backgrounds, 3x enlarged, hotspots marked."""
    names = list(CURSORS)
    cols, zoom_ = 10, 3
    cw = 64 * zoom_ + 16
    rows = math.ceil(len(names) / cols)
    bgs = ["#191c1c", "#7f7f7f", "#f2f2f2"]
    w, h = cols * cw, rows * len(bgs) * cw
    out = cairo.ImageSurface(cairo.FORMAT_RGB24, w, h)
    c = cairo.Context(out)
    for r in range(rows):
        for bi, bg in enumerate(bgs):
            c.set_source_rgba(*rgba(bg))
            c.rectangle(0, (r * len(bgs) + bi) * cw, w, cw)
            c.fill()
    for i, name in enumerate(names):
        for bi in range(len(bgs)):
            x0, y0 = (i % cols) * cw + 8, ((i // cols) * len(bgs) + bi) * cw + 8
            size = 32 if bi != 1 else 64
            z = zoom_ * (2 if size == 32 else 1)
            frame = 2 if name in ANIMATED else 0
            surf, (xh, yh) = draw(name, size, col, frame)
            c.save()
            c.translate(x0, y0)
            c.scale(z, z)
            c.set_source_surface(surf, 0, 0)
            c.get_source().set_filter(cairo.FILTER_NEAREST)
            c.paint()
            c.restore()
            c.set_source_rgba(0, 1, 1, 1)
            c.rectangle(x0 + xh * z, y0 + yh * z, z, z)
            c.set_line_width(1)
            c.stroke()
            if bi == 0:
                c.set_source_rgba(1, 1, 1, 0.6)
                c.select_font_face("monospace")
                c.set_font_size(11)
                c.move_to(x0, y0 + cw - 12)
                c.show_text(name)
    out.write_to_png(path)


def main(argv):
    if len(argv) < 3 or argv[1] not in ("build", "preview"):
        print(__doc__.strip())
        return 2
    col, sizes = dict(COLORS), set(SIZES)
    for arg in argv[3:]:
        k, _, v = arg.partition("=")
        if k == "size" and v.isdigit() and 8 <= int(v) <= 256:
            sizes.add(int(v))
        elif k in COLORS and len(v) == 7 and v[0] == "#" and all(ch in "0123456789abcdefABCDEF" for ch in v[1:]):
            col[k] = v.lower()
        else:
            print("dotfiles-cursors: bad argument '%s'" % arg, file=sys.stderr)
            return 2
    sizes = tuple(sorted(sizes))
    col["idle"] = mix(col["body"], col["edge"], 0.2)     # spinner blocks that are off
    # the running block of the spinner: the accent, unless the body already is the accent
    col["spin"] = col["edge"] if col["accent"] == col["body"] else col["accent"]
    if argv[1] == "preview":
        preview(argv[2], col)
        return 0
    if build(argv[2], col, sizes):
        print("built %s" % argv[2])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
