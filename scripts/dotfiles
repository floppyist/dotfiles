#!/usr/bin/env python3
"""dotfiles - central settings for the desktop

usage: dotfiles apply [--no-reload] [--layout]
                                      generate the theme files from dotfiles.conf, reload the desktop
                                      (--layout: the monitors changed, re-place bar and wallpaper)
       dotfiles check                 only validate the settings
       dotfiles get KEY               print one resolved value (e.g. `dotfiles get accent`)
       dotfiles list                  print all resolved values
       dotfiles edit                  open your settings in $EDITOR (created if missing), then apply
       dotfiles set KEY VALUE         change one of your settings (no apply)
       dotfiles path                  print the path of your settings

Two files: dotfiles.conf in the repository root holds the defaults and documents every key;
your own settings live in ~/.config/dotfiles.conf (only the keys you change; it wins).
`apply` renders templates/* into ~/.config/dotfiles/, which the configs of i3, polybar, rofi,
dunst, alacritty, tmux, neovim, neomutt, GTK, fzf and Firefox include. Shell scripts source
~/.config/dotfiles/theme.sh. The mouse cursor theme is drawn into ~/.icons/dotfiles
(scripts/dotfiles-cursors). Hardware (temperature sensor, backlight) is looked up on every
apply; .xinitrc runs one at every login.

scale = auto takes the factor from the primary monitor (`displays scale`: its density / auto_dpi;
`displays` scales the others so a window has the same physical size everywhere); without X the
last applied factor is kept.
"""
import colorsys
import glob
import math
import os
import re
import shlex
import shutil
import subprocess
import sys

REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
HOME = os.path.expanduser("~")
XDG_CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
DEFAULTS = os.path.join(REPO, "dotfiles.conf")
CONF = os.environ.get("DOTFILES_CONF") or os.path.join(XDG_CONFIG, "dotfiles.conf")
TEMPLATES = os.path.join(REPO, "templates")
OUT = os.path.join(XDG_CONFIG, "dotfiles")
SYS = os.environ.get("DOTFILES_SYSFS") or "/sys"     # tests: a fake /sys

# gruvbox: (normal, bright). The normal colors are ANSI 1..6 of the terminal palette.
GRUVBOX = {
    "red": ("#cc241d", "#fb4934"),
    "green": ("#98971a", "#b8bb26"),
    "yellow": ("#d79921", "#fabd2f"),
    "blue": ("#458588", "#83a598"),
    "purple": ("#b16286", "#d3869b"),
    "aqua": ("#689d6a", "#8ec07c"),
    "orange": ("#d65d0e", "#fe8019"),
}
ANSI = ["red", "green", "yellow", "blue", "purple", "aqua"]  # index + 1 = ANSI color number
TERMINALS = ["alacritty", "kitty", "wezterm", "xterm", "urxvt", "st"]
CURSOR_STYLES = ["light", "dark", "accent"]
CURSOR_THEME = "dotfiles"      # the name in .Xresources, .xinitrc and gtk-3.0/settings.ini
CURSOR_DIR = os.path.join(HOME, ".icons", CURSOR_THEME)   # ~/.icons: xcb-cursor (i3) does not
                                                          # search ~/.local/share/icons
YES_NO = ["yes", "no"]

# The right half of the bar (polybar modules-right). Capsules start with a gap module;
# `bar_hide` and missing hardware take modules out, a capsule left empty loses its gap.
BAR_RIGHT = ("fit music gap-tray tray gap-net wlan ip vpn bluetooth gap-audio volume backlight "
             "gap-sys cpu memory temp gap-bat battery gap-date date date-long").split()
BAR_OPTIONAL = ["music", "tray", "wlan", "ip", "vpn", "bluetooth", "volume", "backlight", "cpu",
                "memory", "temp", "battery"]
# temperature_sensor = auto: the first of these hwmon drivers / thermal zone types
TEMP_SENSORS = ["k10temp", "zenpower", "coretemp", "cpu_thermal", "cpu-thermal", "soc_thermal",
                "x86_pkg_temp", "acpitz"]

# key: (type, default, min, max). Values end up in config files that can run commands
# (i3 exec, polybar actions, tmux, shell), so every type has a strict pattern.
SCHEMA = {
    "accent": ("accent", "red"),
    "accent_text": ("color?", ""),
    "bg": ("color", "#191c1c"),
    "surface": ("color", "#252a2a"),
    "overlay": ("color", "#313838"),
    "fg": ("color", "#ebdbb2"),
    "subtle": ("color", "#a89984"),
    "muted": ("color", "#7c6f64"),
    "scale": ("scale", "auto", 0.5, 4.0),
    "auto_dpi": ("int", "175", 72, 300),
    "firefox_scale": ("float", "1.00", 0.5, 3.0),
    "font": ("font", "JetBrainsMono Nerd Font"),
    "font_size_terminal": ("int", "15", 6, 48),
    "font_size_bar": ("int", "14", 6, 48),
    "font_size_menu": ("int", "13", 6, 48),
    "font_size_notify": ("int", "10", 6, 48),
    "font_size_window": ("int", "10", 6, 48),
    "bar_height": ("int", "40", 16, 120),
    "border_width": ("int", "2", 0, 20),
    "gaps": ("int", "0", 0, 100),
    "terminal_opacity": ("float", "0.90", 0.1, 1.0),
    "terminal_padding_x": ("int", "14", 0, 100),
    "terminal_padding_y": ("int", "10", 0, 100),
    "cursor_style": ("choice", "light", CURSOR_STYLES),
    "cursor_size": ("int", "32", 16, 128),
    "terminal": ("choice", "alacritty", TERMINALS),
    "keyboard_layout": ("xkb", "auto"),
    "wallpaper": ("path?", ""),
    "screenshot_dir": ("path", "auto"),
    "display_key": ("choice", "display", ["display", "bluetooth", "none"]),
    "compositor": ("choice", "auto", ["auto", "glx", "egl", "xrender", "off"]),
    "bar_hide": ("modules", ""),
    "temperature_sensor": ("device", "auto"),
    "backlight": ("device", "auto"),
    "mouse_acceleration": ("choice", "flat", ["auto", "flat", "adaptive"]),
    "mouse_speed": ("signed", "0", -1.0, 1.0),
    "touchpad_tap": ("choice", "yes", ["auto"] + YES_NO),
    "touchpad_natural_scroll": ("choice", "auto", ["auto"] + YES_NO),
    "touchpad_acceleration": ("choice", "auto", ["auto", "flat", "adaptive"]),
    "touchpad_speed": ("signed", "auto", -1.0, 1.0),
    "screensaver_after": ("int", "60", 10, 86400),
    "lock_after": ("int", "300", 0, 86400),
    "display_off_after": ("int", "300", 0, 86400),
}

PATTERNS = {
    "color": r"#[0-9a-fA-F]{6}",
    "font": r"[A-Za-z0-9][A-Za-z0-9 ._-]{0,63}",
    "xkb": r"auto|[a-z]{2,3}(\([a-z0-9_]+\))?(,[a-z]{2,3}(\([a-z0-9_]+\))?){0,3}",
    "path": r"~?[A-Za-z0-9/._ +-]{1,255}",
    "device": r"[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}",
}


class ConfError(Exception):
    pass


# ── parsing and validation ─────────────────────────────────────────────────────

def read_conf(path, raw, errors, optional=False):
    """key = value lines of one file into raw[key] = (value, "file:line")."""
    try:
        lines = open(path, encoding="utf-8").read().splitlines()
    except FileNotFoundError:
        if optional:
            return
        errors.append("cannot read %s: not found" % path)
        return
    except OSError as e:
        errors.append("cannot read %s: %s" % (path, e.strerror))
        return
    seen = set()
    name = path.replace(HOME, "~", 1) if path.startswith(HOME + os.sep) else path
    for n, line in enumerate(lines, 1):
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        where = "%s:%d" % (name, n)
        if "=" not in s:
            errors.append("%s: expected 'key = value'" % where)
            continue
        k, v = (x.strip() for x in s.split("=", 1))
        if k not in SCHEMA:
            errors.append("%s: unknown key '%s'" % (where, k))
        elif k in seen:
            errors.append("%s: '%s' is set twice" % (where, k))
        else:
            seen.add(k)
            raw[k] = (v, where)


def parse(path=None):
    """The defaults (repository dotfiles.conf), then the user's file on top."""
    raw, errors = {}, []
    read_conf(DEFAULTS, raw, errors, optional=True)
    read_conf(path or CONF, raw, errors, optional=True)
    values = {}
    for k, spec in SCHEMA.items():
        v, where = raw.get(k, (spec[1], "default"))
        try:
            values[k] = check(k, v, spec)
        except ValueError as e:
            errors.append("%s: %s: %s" % (where, k, e))
    if errors:
        raise ConfError("\n".join(errors))
    return values


def check(key, v, spec):
    typ = spec[0]
    if typ == "accent":
        if v.lower() in GRUVBOX:
            return v.lower()
        typ = "color"
    if typ == "color?":
        if v == "":
            return ""
        typ = "color"
    if typ == "scale":
        if v == "auto":
            return v
        typ = "float"
    if typ == "path?":
        if v == "":
            return ""
        typ = "path"
    if typ == "signed":
        if v == "auto":
            return v
        if not re.fullmatch(r"-?[0-9]*\.?[0-9]+", v) or not spec[2] <= float(v) <= spec[3]:
            raise ValueError("'%s' is not auto or a number from %g to %g" % (v, spec[2], spec[3]))
        return "%.2f" % (float(v) + 0.0)
    if typ == "modules":
        words = v.split()
        bad = [w for w in words if w not in BAR_OPTIONAL]
        if bad:
            raise ValueError("'%s' is not one of: %s" % (bad[0], " ".join(BAR_OPTIONAL)))
        return " ".join(dict.fromkeys(words))
    if typ == "int":
        if not re.fullmatch(r"[0-9]{1,6}", v) or not spec[2] <= int(v) <= spec[3]:
            raise ValueError("'%s' is not a number from %d to %d" % (v, spec[2], spec[3]))
        return str(int(v))
    if typ == "float":
        try:
            f = float(v) if re.fullmatch(r"[0-9]*\.?[0-9]+", v) else None
        except ValueError:
            f = None
        if f is None or not spec[2] <= f <= spec[3]:
            what = "auto or a number" if spec[0] == "scale" else "a number"
            raise ValueError("'%s' is not %s from %g to %g" % (v, what, spec[2], spec[3]))
        return "%.2f" % f
    if typ == "choice":
        if v not in spec[2]:
            raise ValueError("'%s' is not one of: %s" % (v, ", ".join(spec[2])))
        return v
    if not re.fullmatch(PATTERNS[typ], v):
        hint = {"color": "#rrggbb", "accent": "a gruvbox name or #rrggbb", "font": "letters, digits, space . _ -",
                "xkb": "auto or e.g. de, us, de(nodeadkeys), us,de", "path": "letters, digits, space / . _ + -",
                "device": "auto, none or a device name (letters, digits, _ . : -)"}
        raise ValueError("'%s' is invalid (expected %s)" % (v, hint.get(typ, typ)))
    return v.lower() if typ == "color" else v


# ── derived values ─────────────────────────────────────────────────────────────

def rgb(h):
    return tuple(int(h[i:i + 2], 16) / 255 for i in (1, 3, 5))


def hexc(r, g, b):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(c * 255))) for c in (r, g, b))


def luminance(h):
    def lin(c):
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (lin(c) for c in rgb(h))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    la, lb = sorted((luminance(a), luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def brighten(h, bg):
    """Lighter, more saturated shade (like gruvbox normal -> bright), readable on bg."""
    hh, ll, ss = colorsys.rgb_to_hls(*rgb(h))
    ll, ss = min(0.75, ll + 0.13), min(1.0, ss + 0.15)
    out = hexc(*colorsys.hls_to_rgb(hh, ll, ss))
    while contrast(out, bg) < 4.5 and ll < 0.85:
        ll += 0.03
        out = hexc(*colorsys.hls_to_rgb(hh, ll, ss))
    return out


def nearest_ansi(h):
    def dist(a, b):
        return sum((x - y) ** 2 for x, y in zip(rgb(a), rgb(b)))
    return min(range(len(ANSI)), key=lambda i: dist(h, GRUVBOX[ANSI[i]][0])) + 1


def scaled(n, s):
    """Logical px -> screen px (never 0 for a non-zero value)."""
    n = int(n)
    return max(1, round(n * s)) if n else 0


def monitor_scale():
    """(factor, reason) for scale = auto from `displays scale`: the scale of the primary monitor
    (`displays` scales the others to the same physical size); None without X."""
    if not os.environ.get("DISPLAY") or os.environ.get("DOTFILES_NO_X"):
        return None
    try:
        r = subprocess.run([sys.executable, os.path.join(REPO, "scripts", "displays"), "scale"],
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    m = re.fullmatch(r"([0-9]\.[0-9]{2})\t(.*)", r.stdout.strip()) if r.returncode == 0 else None
    if not m or not 0.5 <= float(m.group(1)) <= 4:
        return None
    # the reason ends up in comments of the generated configs and in theme.sh
    return float(m.group(1)), re.sub(r"[^A-Za-z0-9 _.,()-]", "?", m.group(2))[:160]


def effective_scale(c):
    if c["scale"] != "auto":
        return float(c["scale"]), "dotfiles.conf"
    found = monitor_scale()
    if found:
        return found
    old = old_values().get("scale", "")
    if re.fullmatch(r"[0-9]\.[0-9]{1,2}", old) and 0.5 <= float(old) <= 4:
        return float(old), "no X display: the last applied factor"
    return 1.0, "no X display"


def firefox_dppx(extra, session_gdk):
    """layout.css.devPixelsPerPx. Firefox multiplies a set value by the system text scale
    (Xft.dpi / 96, divided by GDK_SCALE through GDK_DPI_SCALE), and -1 means GDK_SCALE times that
    text scale, which already is `scale`. So only firefox_scale is written, times the GDK_SCALE
    this session started with."""
    if abs(extra - 1) < 0.005:
        return "-1.0"
    gdk = os.environ.get("GDK_SCALE") or str(session_gdk)
    gdk = int(gdk) if re.fullmatch(r"[1-4]", gdk) else 1
    return "%.2f" % (extra * gdk)


# ── hardware and paths (looked up on every apply) ──────────────────────────────

SYSPATH_RE = re.compile(r"/[A-Za-z0-9/._:+-]{1,250}")


def read_line(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.readline().strip()
    except OSError:
        return ""


def numbered(path):
    m = re.search(r"([0-9]+)$", path)
    return (int(m.group(1)) if m else 0, path)


def temp_sensor(choice):
    """The CPU temperature file (millidegrees) for polybar's hwmon-path, "" without one.
    auto: the first of TEMP_SENSORS (hwmon driver names, then thermal zone types); else the
    hwmon name or zone type given in dotfiles.conf. The path holds the hwmon number, which can
    change between boots: .xinitrc applies at every login."""
    if choice == "none":
        return ""
    found = {}
    for d in sorted(glob.glob(os.path.join(SYS, "class", "hwmon", "hwmon*")), key=numbered):
        name, f = read_line(os.path.join(d, "name")), os.path.join(d, "temp1_input")
        if name and name not in found and os.path.exists(f):
            found[name] = f
    for d in sorted(glob.glob(os.path.join(SYS, "class", "thermal", "thermal_zone*")), key=numbered):
        typ, f = read_line(os.path.join(d, "type")), os.path.join(d, "temp")
        if typ and typ not in found and os.path.exists(f):
            found[typ] = f
    for n in TEMP_SENSORS if choice == "auto" else [choice]:
        if n in found:
            p = os.path.realpath(found[n])
            return p if SYSPATH_RE.fullmatch(p) else ""
    return ""


def backlight_device(choice):
    """The backlight to drive (name in /sys/class/backlight), "" without one. auto prefers the
    firmware interface, then platform, then raw (the order desktops use: on hybrid graphics the
    raw one of the other GPU often does nothing)."""
    if choice == "none":
        return ""
    devs = {os.path.basename(d): read_line(os.path.join(d, "type"))
            for d in glob.glob(os.path.join(SYS, "class", "backlight", "*"))}
    if choice != "auto":
        return choice if choice in devs else ""
    rank = {"firmware": 0, "platform": 1, "raw": 2}
    return min(devs, key=lambda n: (rank.get(devs[n], 3), n)) if devs else ""


def pictures_dir():
    """XDG_PICTURES_DIR from ~/.config/user-dirs.dirs (localized names), else ~/Pictures."""
    try:
        for line in open(os.path.join(XDG_CONFIG, "user-dirs.dirs"), encoding="utf-8"):
            m = re.match(r'\s*XDG_PICTURES_DIR="(.+)"\s*$', line)
            if m:
                p = m.group(1).replace("$HOME", HOME)
                if p.startswith("/") and os.path.normpath(p) != HOME:
                    return p
    except OSError:
        pass
    return os.path.join(HOME, "Pictures")


def bar_modules(c, temp, backlight):
    """polybar modules-right without the hidden modules and the gaps of empty capsules."""
    drop = set(c["bar_hide"].split())
    if not temp:
        drop.add("temp")
    if not backlight:
        drop.add("backlight")
    out, gap, mods = [], None, []

    def flush():
        if mods:
            out.extend(([gap] if gap else []) + mods)
    for m in BAR_RIGHT:
        if m.startswith("gap"):
            flush()
            gap, mods = m, []
        elif m not in drop:
            mods.append(m)
    flush()
    return " ".join(out)


DISPLAY_KEY = {
    "display": "bindsym XF86Display exec --no-startup-id ~/.local/bin/display-select.sh",
    "bluetooth": "bindsym XF86Display exec --no-startup-id ~/.local/bin/bluetooth-toggle.sh",
    "none": "# XF86Display is not bound (display_key = none)",
}


def resolve(c):
    v = dict(c)
    s, why = effective_scale(c)

    def px(n):
        return str(scaled(n, s))

    v["scale"] = "%.2f" % s
    v["scale_pct"] = str(round(s * 100))
    v["scale_reason"] = why
    v["dpi"] = str(round(96 * s))
    # GTK draws widgets only at whole factors: from 2 on .xinitrc sets GDK_SCALE (at login) and
    # GDK_DPI_SCALE, which takes that factor back out of the fonts (they follow Xft.dpi already)
    gdk = int(s) if s >= 2 else 1
    v["gdk_scale"] = str(gdk)
    v["gdk_dpi_scale"] = "%.3f" % (1 / gdk)
    v["firefox_dppx"] = firefox_dppx(float(c["firefox_scale"]), gdk)
    v["bar_height_px"] = px(c["bar_height"])
    # i3's rule for its own borders and gaps (logical_px): unscaled below 1.25, rounded up above
    bw = int(c["border_width"])
    v["border_px"] = str(bw if s < 1.25 else math.ceil(bw * s))
    v["cursor_size_px"] = str(min(256, scaled(c["cursor_size"], s)))   # dotfiles-cursors: 8..256
    v["tray_spacing_px"] = px(10)
    if c["accent"] in GRUVBOX:
        v["accent"], bright = GRUVBOX[c["accent"]]
    else:
        bright = brighten(c["accent"], c["bg"])
    v["accent_text"] = c["accent_text"] or bright
    # dark text on the accent (like the red workspace block), unless the accent is too dark for it
    v["on_accent"] = c["bg"] if contrast(v["accent"], c["bg"]) >= 2.5 else c["fg"]
    v["accent_ansi"] = str(nearest_ansi(v["accent"]))
    v["accent_ansi_bright"] = str(nearest_ansi(v["accent"]) + 8)
    for name, (normal, br) in GRUVBOX.items():
        v[name] = normal
        v[name + "_hi"] = br
    # mouse cursor: fill and outline of the shapes
    v["cursor_body"], v["cursor_edge"] = {"light": (c["fg"], c["bg"]), "dark": (c["bg"], c["fg"]),
                                         "accent": (v["accent"], c["fg"])}[c["cursor_style"]]
    v["gray"] = "#928374"
    v["black"] = "#2a3030"
    v["bright"] = "#fbf1c7"
    # polybar: the second font is the smaller one (music title); the offset centers the glyphs
    small = round(int(c["font_size_bar"]) * 0.8)
    v["font_size_bar_small"] = str(small)
    v["bar_font_offset"] = str(round(int(c["font_size_bar"]) * 0.3 * s))
    v["bar_font_offset_small"] = str(round(small * 0.3 * s))
    # width of the terminal's ▌ bar in screen px (half a cell, alacritty truncates): cell =
    # pt * dpi/72 px * 0.6 em (JetBrains Mono's advance). Firefox: the selected tab's underline,
    # the download line.
    v["term_bar_width"] = str(max(1, int(int(c["font_size_terminal"]) * 0.8 * s) // 2))
    # notifications sit 12 px below the bar and 12 px from the right edge
    v["notify_offset_y"] = str(int(c["bar_height"]) + 12)
    # xset s <saver> <cycle>: xss-lock starts the saver after <saver> s and locks after <cycle> more
    lock, saver = int(c["lock_after"]), int(c["screensaver_after"])
    v["lock_cycle"] = str(max(lock - saver, 1)) if lock else "0"
    # no wallpaper (or the file is missing): the background color
    wp = os.path.expanduser(c["wallpaper"]) if c["wallpaper"] else ""
    v["wallpaper"] = wp
    if wp and os.path.isfile(wp):
        v["wallpaper_cmd"] = "feh --no-fehbg --bg-fill " + shlex.quote(wp)
    else:
        v["wallpaper_cmd"] = "xsetroot -solid " + shlex.quote(c["bg"])
    sd = c["screenshot_dir"]
    v["screenshot_dir"] = (os.path.join(pictures_dir(), "screenshots") if sd == "auto"
                           else os.path.expanduser(sd))
    v["temperature_path"] = temp_sensor(c["temperature_sensor"])
    v["backlight_device"] = backlight_device(c["backlight"])
    v["bar_modules_right"] = bar_modules(c, v["temperature_path"], v["backlight_device"])
    v["display_key_binding"] = DISPLAY_KEY[c["display_key"]]
    return v


def load():
    return resolve(parse(CONF))


# ── output ─────────────────────────────────────────────────────────────────────

def render(text, v, name):
    """{{key}} -> the value; {{px:N}} -> N logical px at the current scale."""
    def sub(m):
        if m.group(1) == "px" and m.group(2):
            return str(scaled(m.group(2), float(v["scale"])))
        if m.group(1) not in v or m.group(2):
            raise ConfError("%s: unknown placeholder {{%s}}" % (name, m.group(0)[2:-2].strip()))
        return v[m.group(1)]
    return re.sub(r"\{\{\s*([a-z0-9_]+)(?::([0-9]{1,4}))?\s*\}\}", sub, text)


def theme_sh(v):
    out = ["# Generated by `dotfiles apply` from dotfiles.conf. Do not edit: changes are overwritten.",
           "# shellcheck shell=bash"]
    for k in sorted(v):
        out.append("DF_%s=%s" % (k.upper(), shlex.quote(v[k])))
    return "\n".join(out) + "\n"


def write(path, content):
    """Write only when the content changed (atomic). Returns True if the file changed."""
    try:
        if open(path, encoding="utf-8").read() == content:
            return False
    except OSError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(content)
    os.replace(tmp, path)
    return True


def symlink(target, link):
    """Point `link` at `target`; an existing real file is left alone (reported)."""
    if os.path.islink(link):
        if os.readlink(link) == target:
            return None
        os.unlink(link)
    elif os.path.exists(link):
        return "skipped %s (a real file is in the way)" % link
    os.makedirs(os.path.dirname(link), exist_ok=True)
    os.symlink(target, link)
    return "linked  %s" % link


def firefox_profiles():
    """Profiles whose chrome/userChrome.css is linked to this repository, or that hold copies
    (the snap of Ubuntu may not follow links into hidden directories: marker .dotfiles-copy)."""
    found = []
    for base in (os.path.join(HOME, ".mozilla", "firefox"), os.path.join(XDG_CONFIG, "mozilla", "firefox"),
                 os.path.join(HOME, "snap", "firefox", "common", ".mozilla", "firefox")):
        for chrome in glob.glob(os.path.join(base, "*", "chrome")):
            uc = os.path.join(chrome, "userChrome.css")
            if os.path.realpath(uc).startswith(os.path.join(REPO, "firefox") + os.sep) or \
                    os.path.exists(os.path.join(chrome, ".dotfiles-copy")):
                found.append(chrome)
    return found


def generate(v):
    changed, notes = set(), []
    if write(os.path.join(OUT, "theme.sh"), theme_sh(v)):
        changed.add("theme.sh")
    for path in sorted(glob.glob(os.path.join(TEMPLATES, "*"))):
        name = os.path.basename(path)
        text = render(open(path, encoding="utf-8").read(), v, "templates/" + name)
        if write(os.path.join(OUT, name), text):
            changed.add(name)
    # dunst reads drop-ins only from its own directory, so this is a file there and not a
    # link. (Setups from before install.sh linked file by file have ~/.config/dunst linked to
    # the repository's config/dunst; the file then lands there, gitignored. Its content
    # depends only on dotfiles.conf, never on $HOME.)
    dunst_dir = os.path.join(XDG_CONFIG, "dunst")
    if os.path.isdir(dunst_dir):
        dropin = os.path.join(dunst_dir, "dunstrc.d", "50-dotfiles.conf")
        if os.path.islink(dropin):
            os.unlink(dropin)
        if write(dropin, open(os.path.join(OUT, "dunst.conf"), encoding="utf-8").read()):
            changed.add("dunst.conf")
    # Firefox resolves @import "dotfiles.css" relative to the profile's chrome directory
    for chrome in firefox_profiles():
        if os.path.exists(os.path.join(chrome, ".dotfiles-copy")):
            css = os.path.join(chrome, "dotfiles.css")
            if os.path.islink(css):
                os.unlink(css)
            copied = write(css, open(os.path.join(OUT, "firefox.css"), encoding="utf-8").read())
            for name in ("userChrome.css", "userContent.css"):
                src = os.path.join(REPO, "firefox", name)
                copied |= write(os.path.join(chrome, name), open(src, encoding="utf-8").read())
            if copied:
                changed.add("firefox.css")
        else:
            n = symlink(os.path.join(OUT, "firefox.css"), os.path.join(chrome, "dotfiles.css"))
            if n:
                notes.append(n)
        if firefox_scale(os.path.join(os.path.dirname(chrome), "user.js"), v["firefox_dppx"]):
            changed.add("firefox scale")
    built, note = cursors(v)
    if built:
        changed.add("cursors")
    if note:
        notes.append(note)
    return changed, notes


FF_DPPX = "layout.css.devPixelsPerPx"


def firefox_scale(path, dppx):
    """Set the scale in the profile's user.js (Firefox copies it into its prefs on start).
    Replaces the line in place, so a hand-written user.js keeps its order; a linked user.js is
    written where the link points (the link stays)."""
    line = 'user_pref("%s", "%s");' % (FF_DPPX, dppx)
    if os.path.islink(path) and os.path.exists(path):
        path = os.path.realpath(path)
    try:
        lines = open(path, encoding="utf-8").read().splitlines()
    except FileNotFoundError:
        lines = []
    except OSError:
        return False
    hits = [i for i, l in enumerate(lines) if '"%s"' % FF_DPPX in l]
    if len(hits) == 1 and lines[hits[0]] == line:
        return False
    if hits:
        lines[hits[0]] = line
        lines = [l for i, l in enumerate(lines) if i not in hits[1:]]
    else:
        lines += ["// dotfiles.conf (scale, firefox_scale), written by `dotfiles apply`", line]
    return write(path, "\n".join(lines) + "\n")


def cursors(v):
    """Draw the cursor theme (only when colors, size or the drawing code changed)."""
    cmd = [sys.executable, os.path.join(REPO, "scripts", "dotfiles-cursors"), "build", CURSOR_DIR,
           "body=" + v["cursor_body"], "edge=" + v["cursor_edge"], "accent=" + v["accent"],
           "red=" + v["red"], "size=" + v["cursor_size_px"]]
    try:
        r = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as e:
        return False, "skipped the cursor theme (%s)" % e
    if r.returncode != 0:
        err = (r.stderr.strip().splitlines() or ["exit status %d" % r.returncode])[-1]
        return False, "skipped the cursor theme: %s" % err
    return bool(r.stdout.strip()), None


# ── reload ─────────────────────────────────────────────────────────────────────

def old_values():
    vals = {}
    try:
        for line in open(os.path.join(OUT, "theme.sh"), encoding="utf-8"):
            m = re.match(r"DF_([A-Z0-9_]+)=(.*)$", line.rstrip("\n"))
            if m:
                vals[m.group(1).lower()] = (shlex.split(m.group(2)) or [""])[0]
    except OSError:
        pass
    return vals


def run(cmd, **kw):
    try:
        return subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=10, **kw).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def running(name):
    return run(["pgrep", "-u", str(os.getuid()), "-x", name])


def xrdb_value(key):
    try:
        out = subprocess.run(["xrdb", "-query"], stdin=subprocess.DEVNULL, capture_output=True,
                             text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    for line in out.splitlines():
        k, _, val = line.partition(":")
        if k.strip() == key:
            return val.strip()
    return None


def xrdb_merge(res):
    try:
        return subprocess.run(["xrdb", "-merge"], input=res, text=True, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=10).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def reload(changed, old, v, layout=False):
    done = []
    x11 = bool(os.environ.get("DISPLAY"))
    # The scale: Xft.dpi is what i3, GTK, Qt, alacritty (live) and rofi's fonts follow
    dpi_changed = x11 and xrdb_value("Xft.dpi") != v["dpi"] and xrdb_merge("Xft.dpi: %s\n" % v["dpi"])
    if dpi_changed:
        done.append("Xft.dpi %s" % v["dpi"])
    # i3 reads Xft.dpi only when it starts: restart it in place (keeps the windows). Its
    # exec_always lines re-place polybar and the wallpaper as well.
    i3_restarted = False
    if dpi_changed and running("i3") and run(["i3-msg", "restart"]):
        i3_restarted = True
        done.append("i3 (restart)")
    elif "i3.conf" in changed and running("i3") and run(["i3-msg", "reload"]):
        done.append("i3")
    if x11 and any(old.get(k) != v[k] for k in ("screensaver_after", "lock_after", "display_off_after")):
        run(["xset", "s", "noblank"])
        run(["xset", "s", v["screensaver_after"], v["lock_cycle"]])
        run(["xset", "dpms", "0", "0", v["display_off_after"]])
        done.append("idle times")
    if x11 and v["keyboard_layout"] != "auto" and old.get("keyboard_layout") not in (None, v["keyboard_layout"]):
        layouts, variants = [], []
        for part in v["keyboard_layout"].split(","):
            m = re.fullmatch(r"([a-z]+)(?:\(([a-z0-9_]+)\))?", part)
            layouts.append(m.group(1))
            variants.append(m.group(2) or "")
        cmd = ["setxkbmap", ",".join(layouts)] + (["-variant", ",".join(variants)] if any(variants) else [])
        if run(cmd):
            done.append("keyboard")
    wallpaper_moved = layout or old.get("wallpaper_cmd") not in (None, v["wallpaper_cmd"])
    if x11 and wallpaper_moved and not i3_restarted:
        if run(["sh", "-c", v["wallpaper_cmd"]]):
            done.append("wallpaper")
    input_keys = ("mouse_acceleration", "mouse_speed", "touchpad_tap", "touchpad_natural_scroll",
                  "touchpad_acceleration", "touchpad_speed")
    if x11 and old and any(old.get(k) != v[k] for k in input_keys):
        if run([os.path.join(REPO, "scripts", "input-setup")]):
            done.append("mouse and touchpad")
    if x11 and old.get("compositor") not in (None, v["compositor"]):
        if run([os.path.join(REPO, "scripts", "compositor"), "--restart"]):
            done.append("compositor")
    if x11 and ("cursors" in changed or xrdb_value("Xcursor.size") != v["cursor_size_px"]):
        # the root window (desktop) right away; programs load cursors when they start
        xrdb_merge("Xcursor.theme: %s\nXcursor.size: %s\n" % (CURSOR_THEME, v["cursor_size_px"]))
        env = dict(os.environ, XCURSOR_THEME=CURSOR_THEME, XCURSOR_SIZE=v["cursor_size_px"])
        if run(["xsetroot", "-cursor_name", "left_ptr"], env=env):
            done.append("cursor")
    if x11 and layout:
        # a built-in panel switched off for a mirrored monitor comes back when it is alone again
        run([os.path.join(REPO, "scripts", "polybar-backlight.sh"), "--check"])
    if ("polybar.ini" in changed or layout) and not i3_restarted and running("polybar"):
        launch = os.path.join(XDG_CONFIG, "polybar", "launch.sh")
        if run([launch]):
            done.append("polybar")
    if "dunst.conf" in changed and running("dunst") and run(["dunstctl", "reload"]):
        done.append("dunst")
    if "tmux.conf" in changed and shutil.which("tmux") and run(["tmux", "info"]):
        if run(["tmux", "source-file", os.path.join(XDG_CONFIG, "tmux", "tmux.conf")]):
            done.append("tmux")
    return done


def apply(no_reload, layout=False):
    old = old_values()
    v = load()
    changed, notes = generate(v)
    for n in notes:
        print(n)
    if old.get("scale") != v["scale"]:
        print("dotfiles: scale %s (%s)" % (v["scale"], v["scale_reason"]))
    if changed:
        print("dotfiles: wrote %s" % ", ".join(sorted(changed)))
    if no_reload:
        if not changed:
            print("dotfiles: nothing changed")
        return 0
    done = reload(changed, old, v, layout)
    if done:
        print("dotfiles: reloaded %s" % ", ".join(done))
    elif not changed:
        print("dotfiles: nothing changed")
        return 0
    later = [n for f, n in (("alacritty.toml", "alacritty (reloads itself)"), ("rofi.rasi", "rofi (next start)"),
                            ("fzfrc", "fzf (next start)"),
                            ("nvim.lua", "neovim (next start)"), ("gtk.css", "GTK programs (next start)"),
                            ("firefox.css", "firefox (restart)"), ("firefox scale", "firefox (restart)"),
                            ("cursors", "programs (new cursors on their next start, i3 after a restart)"),
                            ("theme.sh", "shells and lock screen (next start)")) if f in changed]
    if later:
        print("dotfiles: picked up by %s" % ", ".join(dict.fromkeys(later)))
    if old.get("cursor_size_px") not in (None, v["cursor_size_px"]):
        print("dotfiles: the cursor size reaches every program after logging in again (XCURSOR_SIZE)")
    if old.get("scale") not in (None, v["scale"]):
        print("dotfiles: GTK and Qt programs pick the scale up on their next start; at 2 and above "
              "their widgets after logging in again (GDK_SCALE)")
    return 0


USER_HEADER = """\
# Your dotfiles settings. Only the keys you want different from the defaults; they win over
# %s, which documents every key.
# After editing run `dotfiles apply` (`dotfiles edit` does it for you).

"""


def ensure_user_conf():
    if not os.path.exists(CONF):
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        with open(CONF, "w", encoding="utf-8") as f:
            f.write(USER_HEADER % DEFAULTS.replace(HOME, "~", 1))


def set_value(key, value):
    """Write `key = value` into the user's file (replaces the key's line, keeps the rest)."""
    if key not in SCHEMA:
        raise ConfError("unknown key '%s'" % key)
    try:
        check(key, value, SCHEMA[key])
    except ValueError as e:
        raise ConfError("%s: %s" % (key, e))
    ensure_user_conf()
    lines = open(CONF, encoding="utf-8").read().splitlines()
    line = "%s = %s" % (key, value)
    hits = [i for i, l in enumerate(lines) if re.match(r"\s*%s\s*=" % re.escape(key), l)]
    if hits:
        lines[hits[0]] = line
        lines = [l for i, l in enumerate(lines) if i not in hits[1:]]
    else:
        lines.append(line)
    write(CONF, "\n".join(lines) + "\n")
    load()      # the whole result must still be valid


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "help"
    try:
        if cmd == "apply":
            return apply("--no-reload" in argv[2:], "--layout" in argv[2:])
        if cmd == "check":
            load()
            print("dotfiles: the settings are valid (%s over %s)" % (CONF, DEFAULTS))
            return 0
        if cmd == "set" and len(argv) == 4:
            set_value(argv[2], argv[3])
            print("dotfiles: %s = %s in %s" % (argv[2], argv[3], CONF))
            return 0
        if cmd == "get" and len(argv) == 3:
            v = load()
            if argv[2] not in v:
                print("dotfiles: unknown key '%s'" % argv[2], file=sys.stderr)
                return 1
            print(v[argv[2]])
            return 0
        if cmd == "list":
            for k, val in sorted(load().items()):
                print("%-22s %s" % (k, val))
            return 0
        if cmd == "path":
            print(CONF)
            return 0
        if cmd == "edit":
            ensure_user_conf()
            editor = shlex.split(os.environ.get("VISUAL") or os.environ.get("EDITOR") or "nvim")
            subprocess.call(editor + [CONF])
            return apply(False)
    except ConfError as e:
        print("dotfiles: invalid settings:\n%s" % "\n".join("  " + l for l in str(e).splitlines()),
              file=sys.stderr)
        return 1
    print(__doc__.strip())
    return 0 if cmd in ("help", "-h", "--help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
